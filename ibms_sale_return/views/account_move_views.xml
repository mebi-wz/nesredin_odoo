<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_sale_return" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sale.return</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="sale_return_order_id" invisible="1"/>
                <div class="alert alert-info mb-0" role="alert" invisible="not sale_return_order_id">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Sales Return Credit Note: </strong>
                            Generated from Sales Return Order 
                            <field name="sale_return_order_id" readonly="1" class="d-inline fw-bold"/>.
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(sale.action_orders)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-undo"
                        context="{'search_default_name': sale_return_order_id}"
                        invisible="not sale_return_order_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Return SO</span>
                        <span class="o_stat_value"><field name="sale_return_order_id" readonly="1"/></span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

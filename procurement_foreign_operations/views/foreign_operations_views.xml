    <!-- Margin Configuration Modal Form View -->
    <record id="view_purchase_order_margin_modal_form" model="ir.ui.view">
        <field name="name">purchase.order.margin.modal.form</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <form string="Manage Margins">
                <sheet>
                    <group col="4">
                        <field name="name" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="amount_total" readonly="1" string="Total Amount (USD)"/>
                        <field name="amount_total_display" readonly="1" string="Total (ETB)"/>
                        <field name="margin_bill_status" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Margin Installments" name="margins">
                            <field name="margin_line_ids">
                                <list editable="bottom">
                                    <field name="margin_order" optional="show" string="Installment"/>
                                    <field name="margin_percent" sum="Total %" width="8%"/>
                                    <field name="calculation" optional="show"/>
                                    <field name="usd_amount" string="USD" sum="Total USD" width="12%"/>
                                    <field name="exchange_rate" string="Exch. Rate" width="10%"/>
                                    <field name="etb_amount" string="ETB" sum="Total ETB" width="12%"/>
                                    <field name="account_id" options="{'no_create': True}"/>
                                    <field name="lc_reference" options="{'no_create': True, 'no_open': True}" optional="hide"/>
                                    <field name="move_id" readonly="1" optional="show" string="Bill"/>
                                    <button name="action_create_bill" type="object" string="CREATE BILL" 
                                            class="oe_highlight btn-sm" 
                                            invisible="move_id != False or parent.state not in ('purchase', 'done')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Save &amp; Close" class="btn-primary" special="save"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Extend Landed Cost Form - Add Product Summary Tab -->
    <record id="view_stock_landed_cost_form_foreign_ops" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.foreign.ops</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_ids']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='vendor_bill_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='cost_lines']/list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
            <xpath expr="//notebook/page[last()]" position="after">
                <page string="Product Summary">
                    <field name="summary_line_ids" readonly="1">
                        <list>
                            <field name="product_id"/>
                            <field name="quantity" sum="Total Quantity"/>
                            <field name="customs_cost_value" sum="Total Customs Value"/>
                            <field name="former_cost" sum="Total Original Value"/>
                            <field name="new_cost" sum="Total New Value"/>
                            <field name="allocated_cost" sum="Total Landed Cost Added"/>
                            <field name="proportion" sum="Total Proportion"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>

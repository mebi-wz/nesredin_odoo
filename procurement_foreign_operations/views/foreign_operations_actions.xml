<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_foreign_payment_request" model="ir.actions.act_window">
        <field name="name">Payment Requests</field>
        <field name="res_model">foreign.payment.request</field>
        <field name="view_mode">list,form</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first payment request
            </p>
        </field>
    </record>

    <record id="action_foreign_lc" model="ir.actions.act_window">
        <field name="name">Letters of Credit</field>
        <field name="res_model">foreign.lc</field>
        <field name="view_mode">list,form</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Letter of Credit
            </p>
        </field>
    </record>
        <!-- Action for Foreign Purchase Orders -->
    <record id="action_foreign_purchase_order" model="ir.actions.act_window">
        <field name="name">Foreign Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('request_type', '=', 'foreign')]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>


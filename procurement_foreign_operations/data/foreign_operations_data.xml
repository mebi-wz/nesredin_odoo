<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_foreign_payment_request" model="ir.sequence">
            <field name="name">Foreign Payment Request</field>
            <field name="code">foreign.payment.request</field>
            <field name="prefix">FP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_foreign_lc" model="ir.sequence">
            <field name="name">Letter of Credit</field>
            <field name="code">foreign.lc</field>
            <field name="prefix">LC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>


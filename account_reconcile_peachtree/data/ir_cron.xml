<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_create_missing_journals" model="ir.cron">
            <field name="name">Account: Create Missing Bank/Cash Journals</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="state">code</field>
            <field name="code">model.cron_create_missing_journals()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
        
        <record id="ir_cron_auto_generate_reconciliations" model="ir.cron">
            <field name="name">Account: Auto-Generate Period Reconciliations</field>
            <field name="model_id" ref="account_reconcile_peachtree.model_account_bank_reconciliation_period"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_generate_reconciliations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

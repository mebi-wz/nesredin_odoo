<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Form view ─────────────────────────────────────────────────────── -->
    <record id="view_bank_reconciliation_period_form" model="ir.ui.view">
        <field name="name">account.bank.reconciliation.period.form</field>
        <field name="model">account.bank.reconciliation.period</field>
        <field name="arch" type="xml">
            <form string="Saved Reconciliation" create="1" delete="0">
                <header>
                    <button name="action_set_balanced"
                            string="Mark as Balanced"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'open' or difference != 0"/>
                    <button name="action_lock"
                            string="Lock"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'balanced'"
                            confirm="Locking this record prevents any further changes. Continue?"/>
                    <button name="action_reopen"
                            string="Re-open"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('balanced',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,balanced,locked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <!-- Left: identification -->
                        <group string="Period">
                            <field name="journal_id" readonly="state != 'open'"/>
                            <field name="period_date" readonly="state != 'open'"
                                   string="Statement Date"/>
                            <field name="statement_balance" readonly="state != 'open'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <!-- Right: snapshot balances -->
                        <group string="Reconciliation Summary">
                            <field name="book_balance" readonly="1"/>
                            <field name="outstanding_deposits" readonly="1"/>
                            <field name="outstanding_checks" readonly="1"/>
                            <field name="difference" readonly="1"
                                   decoration-danger="difference != 0"
                                   decoration-success="difference == 0"/>
                        </group>
                    </group>

                    <field name="notes" placeholder="Add notes…"
                           readonly="state == 'locked'"/>

                    <!-- ── Saved line tabs ─────────────────────────────── -->
                    <notebook>
                        <page string="Outstanding Deposits" name="outstanding_deposits">
                            <field name="outstanding_deposit_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <header>
                                        <button name="action_reconcile_bulk_manually" string="Bulk Reconcile" type="object" class="btn-primary" invisible="parent.state != 'open'"/>
                                    </header>
                                    <field name="date"/>
                                    <field name="move_id" string="Journal Entry"/>
                                    <field name="name" string="Description"/>
                                    <field name="partner_id"/>
                                    <field name="amount_residual" string="Amount"
                                           sum="Total"/>
                                    <button name="action_reconcile_row_manually"
                                            string="Reconcile"
                                            type="object"
                                            class="btn-primary btn-sm"
                                            invisible="parent.state != 'open'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outstanding Checks/Payments" name="outstanding_checks">
                            <field name="outstanding_check_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <header>
                                        <button name="action_reconcile_bulk_manually" string="Bulk Reconcile" type="object" class="btn-primary" invisible="parent.state != 'open'"/>
                                    </header>
                                    <field name="date"/>
                                    <field name="move_id" string="Journal Entry"/>
                                    <field name="name" string="Description"/>
                                    <field name="partner_id"/>
                                    <field name="amount_residual" string="Amount"
                                           sum="Total"/>
                                    <button name="action_reconcile_row_manually"
                                            string="Reconcile"
                                            type="object"
                                            class="btn-primary btn-sm"
                                            invisible="parent.state != 'open'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reconciled Items" name="reconciled_items">
                            <field name="reconciled_line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <header>
                                        <button name="action_unreconcile_bulk_manually" string="Bulk Unreconcile" type="object" class="btn-secondary" invisible="parent.state != 'open'"/>
                                    </header>
                                    <field name="date"/>
                                    <field name="move_id" string="Journal Entry"/>
                                    <field name="name" string="Description"/>
                                    <field name="partner_id"/>
                                    <field name="debit" sum="Debits"/>
                                    <field name="credit" sum="Credits"/>
                                    <field name="matching_number" string="Matching #"/>
                                    <button name="action_unreconcile_row_manually"
                                            string="Unreconcile"
                                            type="object"
                                            class="btn-secondary btn-sm"
                                            invisible="parent.state != 'open'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── List view ─────────────────────────────────────────────────────── -->
    <record id="view_bank_reconciliation_period_list" model="ir.ui.view">
        <field name="name">account.bank.reconciliation.period.list</field>
        <field name="model">account.bank.reconciliation.period</field>
        <field name="arch" type="xml">
            <list string="Bank Reconciliation" create="1" delete="0"
                  decoration-success="state == 'balanced' and difference == 0"
                  decoration-danger="difference != 0"
                  decoration-muted="state == 'locked'">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="period_date" string="Statement Date"/>
                <field name="statement_balance"/>
                <field name="book_balance"/>
                <field name="outstanding_deposits"/>
                <field name="outstanding_checks"/>
                <field name="difference"
                       decoration-danger="difference != 0"
                       decoration-success="difference == 0"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'balanced'"
                       decoration-danger="state == 'open' and difference != 0"
                       decoration-info="state == 'locked'"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────── -->
    <record id="action_bank_reconciliation_period" model="ir.actions.act_window">
        <field name="name">Bank Reconciliation</field>
        <field name="res_model">account.bank.reconciliation.period</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <!-- ── Menuitem ──────────────────────────────────────────────────────── -->
    <menuitem id="menu_bank_reconciliation_period"
              name="Bank Reconciliation"
              parent="account.menu_finance_entries"
              action="action_bank_reconciliation_period"
              sequence="16"/>
</odoo>

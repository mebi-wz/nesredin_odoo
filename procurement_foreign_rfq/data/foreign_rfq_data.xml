<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_foreign_proforma" model="ir.sequence">
            <field name="name">Foreign Proforma</field>
            <field name="code">foreign.rfq</field>
            <field name="prefix">RFQ-F%(range_y)s</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_currency_request" model="ir.sequence">
            <field name="name">Currency Request</field>
            <field name="code">procurement.currency.request</field>
            <field name="prefix">CR-F%(range_y)s</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>

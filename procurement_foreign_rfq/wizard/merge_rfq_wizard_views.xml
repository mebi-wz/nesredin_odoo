<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_foreign_rfq_merge_wizard_form" model="ir.ui.view">
        <field name="name">foreign.rfq.merge.wizard.form</field>
        <field name="model">foreign.rfq.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge PRs into RFQ">
                <group>
                    <field name="vendor_id"/>
                </group>
                <group string="Selected Requisitions">
                    <field name="requisition_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_merge" string="Merge" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_foreign_rfq_merge_wizard" model="ir.actions.act_window">
        <field name="name">Merge into RFQ</field>
        <field name="res_model">foreign.rfq.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="procurement_foreign_purchase.model_foreign_purchase_requisition"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>

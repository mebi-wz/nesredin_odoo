<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_foreign_rfq_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="address">
                        <div t-field="doc.vendor_id"
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                    </t>
                    <div class="page">
                        <div class="oe_structure"/>

                        <t t-set="layout_document_title">
                            <span>Request for Quotation <span t-field="doc.name"/></span>
                        </t>


                        <!-- Informations Block -->
                        <div id="informations" class="row mb-3">
                            <div t-if="doc.date_rfq" class="col-3 bm-2">
                                <strong>RFQ Date:</strong>
                                <p t-field="doc.date_rfq" t-options="{'widget': 'date'}" class="m-0"/>
                            </div>
                            <div t-if="doc.requisition_id" class="col-3 bm-2">
                                <strong>Source Requisition:</strong>
                                <p t-field="doc.requisition_id.name" class="m-0"/>
                            </div>
                            <div t-if="doc.incoterm" class="col-3 bm-2">
                                <strong>Incoterm:</strong>
                                <p class="m-0"><span t-field="doc.incoterm.code"/> - <span t-field="doc.incoterm.name"/></p>
                            </div>
                            <div t-if="doc.currency_id" class="col-3 bm-2">
                                <strong>Currency:</strong>
                                <p t-field="doc.currency_id.name" class="m-0"/>
                            </div>
                        </div>

                        <div id="informations_trade" class="row mb-4" t-if="doc.mod_of_shipment or doc.port_of_loading or doc.port_of_discharge or doc.payment_terms">
                            <div t-if="doc.mod_of_shipment" class="col-3 bm-2">
                                <strong>Mode of Shipment:</strong>
                                <p t-field="doc.mod_of_shipment" class="m-0" style="text-transform: uppercase;"/>
                            </div>
                            <div t-if="doc.port_of_loading" class="col-3 bm-2">
                                <strong>Port of Loading:</strong>
                                <p t-field="doc.port_of_loading.name" class="m-0"/>
                            </div>
                            <div t-if="doc.port_of_discharge" class="col-3 bm-2">
                                <strong>Port of Discharge:</strong>
                                <p t-field="doc.port_of_discharge.name" class="m-0"/>
                            </div>
                            <div t-if="doc.payment_terms" class="col-3 bm-2">
                                <strong>Payment Terms:</strong>
                                <p t-field="doc.payment_terms" class="m-0" style="text-transform: uppercase;"/>
                            </div>
                        </div>

                        <!-- Lines Table -->
                        <t t-set="has_prices" t-value="any(line.price_unit > 0 for line in doc.line_ids)"/>
                        <table class="table table-sm o_main_table table-borderless">
                            <thead style="display: table-row-group">
                                <tr>
                                    <th name="th_part_number" class="text-start"><strong>Part Number</strong></th>
                                    <th name="th_description" class="text-start"><strong>Description</strong></th>
                                    <th name="th_hs_code" class="text-center"><strong>HS Code</strong></th>
                                    <th name="th_quantity" class="text-end"><strong>Qty</strong></th>
                                    <th t-if="has_prices" name="th_price_unit" class="text-end"><strong>Unit Price</strong></th>
                                    <th t-if="has_prices" name="th_subtotal" class="text-end"><strong>Amount</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <!-- Part Number (used instead of internal product code) -->
                                        <td class="text-start">
                                            <t t-set="part_no" t-value="line.part_number or (line.product_id and line.product_id.part_number) or ''"/>
                                            <span t-out="part_no or '-'"/>
                                        </td>
                                        <!-- Description (with internal product code stripped if present) -->
                                        <td class="text-start">
                                            <t t-set="prod_code" t-value="line.product_id and line.product_id.default_code or ''"/>
                                            <t t-set="desc" t-value="line.description or (line.product_id and line.product_id.name) or ''"/>
                                            <t t-if="prod_code and ('[' + prod_code + ']') in desc">
                                                <t t-set="desc" t-value="desc.replace('[' + prod_code + ']', '').strip()"/>
                                            </t>
                                            <span t-out="desc"/>
                                        </td>
                                        <!-- HS Code -->
                                        <td class="text-center">
                                            <t t-set="hs_val" t-value="line.hs_code or ''"/>
                                            <span t-out="hs_val or '-'"/>
                                            <div t-if="line.hs_description" class="text-muted small">
                                                <span t-field="line.hs_description"/>
                                            </div>
                                        </td>
                                        <!-- Quantity -->
                                        <td class="text-end">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.uom_id.name"/>
                                        </td>
                                        <!-- Unit Price -->
                                        <td t-if="has_prices" class="text-end">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                        <!-- Amount -->
                                        <td t-if="has_prices" class="text-end">
                                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totals Section -->
                        <div id="total" class="row justify-content-end mb-4" t-if="has_prices" style="page-break-inside: avoid;">
                            <div class="col-4">
                                <table class="table table-sm table-borderless">
                                    <tr class="border-black o_subtotal">
                                        <td><strong>Total (<span t-field="doc.currency_id.name"/>)</strong></td>
                                        <td class="text-end">
                                            <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="doc.exchange_rate and doc.exchange_rate &gt; 1" class="border-black">
                                        <td><strong>Total (ETB)</strong></td>
                                        <td class="text-end">
                                            <t t-out="'Br {:,.2f}'.format(doc.amount_total_etb)"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Terms and Conditions -->
                        <div t-if="doc.terms_conditions" class="mt-4" style="page-break-inside: avoid;">
                            <strong>Terms and Conditions:</strong>
                            <p t-field="doc.terms_conditions" class="m-0"/>
                        </div>

                        <!-- Signatures Section -->
                        <div class="row mt-5 pt-3" style="page-break-inside: avoid;" t-if="doc.create_uid or doc.op_approved_by or doc.approved_by">
                            <div class="col-4 text-center" t-if="doc.create_uid">
                                <div style="border-top: 1px solid #dee2e6; padding-top: 8px;">
                                    <strong>Prepared By</strong>
                                    <div><span t-field="doc.create_uid.name"/></div>
                                </div>
                            </div>
                            <div class="col-4 text-center" t-if="doc.op_approved_by">
                                <div style="border-top: 1px solid #dee2e6; padding-top: 8px;">
                                    <strong>Verified By</strong>
                                    <div><span t-field="doc.op_approved_by.name"/></div>
                                    <div t-if="doc.op_approval_date" class="text-muted small">
                                        <span t-field="doc.op_approval_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4 text-center" t-if="doc.approved_by">
                                <div style="border-top: 1px solid #dee2e6; padding-top: 8px;">
                                    <strong>Approved By</strong>
                                    <div><span t-field="doc.approved_by.name"/></div>
                                    <div t-if="doc.approval_date" class="text-muted small">
                                        <span t-field="doc.approval_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_foreign_rfq_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1e293b; font-size: 12px; line-height: 1.4;">
                        
                        <!-- Document Header: Title, Number, Status Badge -->
                        <div class="row align-items-center mb-3 pb-2" style="border-bottom: 2px solid #0f2942;">
                            <div class="col-7">
                                <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #64748b; display: block;">
                                    Foreign Procurement
                                </span>
                                <h2 class="m-0" style="color: #0f2942; font-weight: 800; font-size: 24px; letter-spacing: -0.5px;">
                                    Request for Quotation
                                </h2>
                                <div style="font-size: 15px; font-weight: 600; color: #2563eb; margin-top: 2px;">
                                    <span t-field="doc.name"/>
                                    <span t-if="doc.requisition_id" style="font-size: 12px; font-weight: 500; color: #64748b; margin-left: 8px;">
                                        (Source: <span t-field="doc.requisition_id.name"/>)
                                    </span>
                                </div>
                            </div>
                            <div class="col-5 text-end">
                                <!-- Status Badge -->
                                <t t-set="badge_bg" t-value="'#e2e8f0'"/>
                                <t t-set="badge_color" t-value="'#334155'"/>
                                <t t-if="doc.state in ['approved', 'po_created']">
                                    <t t-set="badge_bg" t-value="'#dcfce7'"/>
                                    <t t-set="badge_color" t-value="'#166534'"/>
                                </t>
                                <t t-elif="doc.state in ['submitted', 'verified']">
                                    <t t-set="badge_bg" t-value="'#fef3c7'"/>
                                    <t t-set="badge_color" t-value="'#92400e'"/>
                                </t>
                                <t t-elif="doc.state == 'cancel'">
                                    <t t-set="badge_bg" t-value="'#fee2e2'"/>
                                    <t t-set="badge_color" t-value="'#991b1b'"/>
                                </t>
                                <span t-attf-style="display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; background-color: {{ badge_bg }}; color: {{ badge_color }};">
                                    <span t-field="doc.state"/>
                                </span>
                                <div class="mt-1" style="font-size: 11px; color: #64748b;">
                                    <span>Date: </span><strong style="color: #0f2942;"><span t-field="doc.date_rfq" t-options='{"widget": "date"}'/></strong>
                                </div>
                            </div>
                        </div>

                        <!-- Top Information Cards: Supplier (Left) & Shipping/Trade (Right) -->
                        <div class="row mb-3 g-2">
                            <!-- Supplier Card -->
                            <div class="col-6">
                                <div style="border: 1px solid #e2e8f0; border-radius: 6px; background-color: #f8fafc; padding: 10px 12px; height: 100%;">
                                    <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #0f2942; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; margin-bottom: 6px;">
                                        Overseas Supplier / Vendor
                                    </div>
                                    <div t-if="doc.vendor_id">
                                        <div style="font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 2px;">
                                            <span t-field="doc.vendor_id.name"/>
                                        </div>
                                        <div style="color: #475569; font-size: 11px; line-height: 1.35;">
                                            <span t-if="doc.vendor_id.street" t-field="doc.vendor_id.street"/><br t-if="doc.vendor_id.street"/>
                                            <span t-if="doc.vendor_id.street2" t-field="doc.vendor_id.street2"/><br t-if="doc.vendor_id.street2"/>
                                            <span t-if="doc.vendor_id.city"><span t-field="doc.vendor_id.city"/>, </span>
                                            <span t-if="doc.vendor_id.country_id" t-field="doc.vendor_id.country_id.name"/><br t-if="doc.vendor_id.city or doc.vendor_id.country_id"/>
                                            <span t-if="doc.vendor_id.phone"><strong>Phone:</strong> <span t-field="doc.vendor_id.phone"/> </span>
                                            <span t-if="doc.vendor_id.email"><strong>Email:</strong> <span t-field="doc.vendor_id.email"/></span>
                                        </div>
                                    </div>
                                    <div t-else="" class="text-muted" style="font-style: italic; font-size: 11px;">
                                        No Supplier Assigned
                                    </div>
                                </div>
                            </div>

                            <!-- Shipping & Logistics Card -->
                            <div class="col-6">
                                <div style="border: 1px solid #e2e8f0; border-radius: 6px; background-color: #f8fafc; padding: 10px 12px; height: 100%;">
                                    <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #0f2942; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; margin-bottom: 6px;">
                                        Shipment &amp; Trade Logistics
                                    </div>
                                    <table style="width: 100%; font-size: 11px; color: #475569;" cellpadding="1" cellspacing="0">
                                        <tr t-if="doc.mod_of_shipment">
                                            <td style="width: 45%; font-weight: 600; color: #334155;">Mode of Shipment:</td>
                                            <td style="font-weight: 700; color: #0f172a;"><span t-field="doc.mod_of_shipment"/></td>
                                        </tr>
                                        <tr t-if="doc.incoterm">
                                            <td style="font-weight: 600; color: #334155;">Incoterm:</td>
                                            <td style="font-weight: 700; color: #0f172a;"><span t-field="doc.incoterm.code"/> - <span t-field="doc.incoterm.name"/></td>
                                        </tr>
                                        <tr t-if="doc.port_of_loading">
                                            <td style="font-weight: 600; color: #334155;">Port of Loading:</td>
                                            <td><span t-field="doc.port_of_loading.name"/></td>
                                        </tr>
                                        <tr t-if="doc.port_of_discharge">
                                            <td style="font-weight: 600; color: #334155;">Port of Discharge:</td>
                                            <td><span t-field="doc.port_of_discharge.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: 600; color: #334155;">Final Destination:</td>
                                            <td>
                                                <span t-if="doc.port_of_final_destination" t-field="doc.port_of_final_destination.name"/>
                                                <span t-elif="doc.shipping_destination" t-field="doc.shipping_destination"/>
                                                <span t-else="">Addis Ababa, Ethiopia</span>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Commercial & Trade Terms Bar -->
                        <div class="mb-3" style="border: 1px solid #e2e8f0; border-radius: 6px; background-color: #ffffff; padding: 8px 12px;">
                            <div class="row text-center" style="font-size: 11px;">
                                <div class="col-3" style="border-right: 1px solid #e2e8f0;">
                                    <span style="font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: 600; display: block;">Proforma Invoice</span>
                                    <strong style="color: #0f172a;">
                                        <span t-if="doc.proforma_invoice_no" t-field="doc.proforma_invoice_no"/>
                                        <span t-else="" class="text-muted">N/A</span>
                                    </strong>
                                    <div t-if="doc.proforma_invoice_date" style="font-size: 10px; color: #64748b;">
                                        <span t-field="doc.proforma_invoice_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                                <div class="col-3" style="border-right: 1px solid #e2e8f0;">
                                    <span style="font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: 600; display: block;">Payment Terms</span>
                                    <strong style="color: #0f172a; text-transform: uppercase;">
                                        <span t-if="doc.payment_terms" t-field="doc.payment_terms"/>
                                        <span t-else="" class="text-muted">N/A</span>
                                    </strong>
                                </div>
                                <div class="col-3" style="border-right: 1px solid #e2e8f0;">
                                    <span style="font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: 600; display: block;">Order Currency</span>
                                    <strong style="color: #2563eb; font-size: 12px;">
                                        <span t-field="doc.currency_id.name"/>
                                    </strong>
                                    <div t-if="doc.exchange_rate and doc.exchange_rate &gt; 1" style="font-size: 10px; color: #64748b;">
                                        Rate: <strong><t t-out="'%.2f' % doc.exchange_rate"/> ETB</strong>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <span style="font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: 600; display: block;">Validity Period</span>
                                    <strong style="color: #0f172a;">
                                        <span t-if="doc.validity_period" t-field="doc.validity_period" t-options='{"widget": "date"}'/>
                                        <span t-else="" class="text-muted">30 Days</span>
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <!-- Products Table with Dedicated Part Number Column -->
                        <table class="table table-sm table-bordered mt-2 mb-3" style="font-size: 11px; border-color: #cbd5e1; width: 100%;">
                            <thead>
                                <tr style="background-color: #0f2942; color: #ffffff;">
                                    <th class="text-center align-middle" style="width: 4%; padding: 6px 3px; font-weight: 700;">#</th>
                                    <th class="text-start align-middle" style="width: 20%; padding: 6px 8px; font-weight: 700; letter-spacing: 0.3px;">Part Number</th>
                                    <th class="text-start align-middle" style="width: 36%; padding: 6px 8px; font-weight: 700; letter-spacing: 0.3px;">Product Description</th>
                                    <th class="text-center align-middle" style="width: 8%; padding: 6px 4px; font-weight: 700;">UoM</th>
                                    <th class="text-end align-middle" style="width: 8%; padding: 6px 6px; font-weight: 700;">Qty</th>
                                    <th class="text-end align-middle" style="width: 12%; padding: 6px 6px; font-weight: 700;">Unit Price (<t t-out="doc.currency_id.name"/>)</th>
                                    <th class="text-end align-middle" style="width: 12%; padding: 6px 6px; font-weight: 700;">Subtotal (<t t-out="doc.currency_id.name"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr t-attf-style="background-color: {{ '#f8fafc' if line_index % 2 == 1 else '#ffffff' }};">
                                        <!-- Line No -->
                                        <td class="text-center align-middle" style="color: #64748b; font-weight: 600; padding: 6px 3px;">
                                            <span t-field="line.line_no"/>
                                        </td>
                                        <!-- Part Number -->
                                        <td class="text-start align-middle" style="padding: 6px 8px;">
                                            <t t-set="part_no" t-value="line.part_number or (line.product_id and line.product_id.part_number)"/>
                                            <t t-set="prod_code" t-value="line.product_id and line.product_id.default_code"/>
                                            <div style="font-weight: 700; color: #0f172a; font-family: Consolas, 'Courier New', monospace; font-size: 11.5px;">
                                                <t t-if="part_no" t-out="part_no"/>
                                                <t t-elif="prod_code" t-out="prod_code"/>
                                                <t t-else="">-</t>
                                            </div>
                                            <div t-if="prod_code and part_no and prod_code != part_no" style="font-size: 9.5px; color: #64748b;">
                                                Ref: <t t-out="prod_code"/>
                                            </div>
                                        </td>
                                        <!-- Product Description -->
                                        <td class="text-start align-middle" style="padding: 6px 8px;">
                                            <div style="font-weight: 600; color: #0f172a;">
                                                <span t-field="line.product_id.name"/>
                                            </div>
                                            <div t-if="line.description and line.description != line.product_id.name" style="color: #475569; font-size: 10.5px; margin-top: 1px;">
                                                <span t-field="line.description"/>
                                            </div>
                                            <div t-if="line.hs_code" style="margin-top: 2px;">
                                                <span style="display: inline-block; padding: 1px 5px; border-radius: 3px; background-color: #e2e8f0; color: #334155; font-size: 9px; font-weight: 600;">
                                                    HS: <span t-field="line.hs_code"/>
                                                    <span t-if="line.hs_description"> (<span t-field="line.hs_description"/>)</span>
                                                </span>
                                            </div>
                                        </td>
                                        <!-- UoM -->
                                        <td class="text-center align-middle" style="color: #475569; padding: 6px 4px;">
                                            <span t-field="line.uom_id.name"/>
                                        </td>
                                        <!-- Quantity -->
                                        <td class="text-end align-middle" style="font-weight: 700; color: #0f172a; padding: 6px 6px;">
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <!-- Unit Price -->
                                        <td class="text-end align-middle" style="color: #334155; padding: 6px 6px;">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                        <!-- Subtotal -->
                                        <td class="text-end align-middle" style="font-weight: 700; color: #0f172a; padding: 6px 6px;">
                                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totals Section -->
                        <div class="row justify-content-end mb-4" style="page-break-inside: avoid;">
                            <div class="col-6">
                                <table class="table table-sm" style="font-size: 11.5px; border: 1px solid #cbd5e1; border-radius: 6px; overflow: hidden;" cellpadding="4" cellspacing="0">
                                    <tr style="background-color: #f8fafc;">
                                        <td style="font-weight: 600; color: #334155; border-bottom: 1px solid #e2e8f0;">
                                            Subtotal / Total (<span t-field="doc.currency_id.name"/>):
                                        </td>
                                        <td class="text-end" style="font-weight: 700; color: #0f172a; border-bottom: 1px solid #e2e8f0;">
                                            <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <t t-if="doc.exchange_rate and doc.exchange_rate &gt; 1">
                                        <tr style="background-color: #ffffff; color: #64748b; font-size: 10.5px;">
                                            <td style="border-bottom: 1px solid #e2e8f0;">
                                                Applied Exchange Rate:
                                            </td>
                                            <td class="text-end" style="border-bottom: 1px solid #e2e8f0; font-weight: 600;">
                                                1 <span t-field="doc.currency_id.name"/> = <t t-out="'%.2f' % doc.exchange_rate"/> ETB
                                            </td>
                                        </tr>
                                        <tr style="background-color: #f1f5f9; font-size: 13px; border-top: 2px solid #0f2942;">
                                            <td style="font-weight: 800; color: #0f2942;">
                                                Equivalent Total (ETB / Birr):
                                            </td>
                                            <td class="text-end" style="font-weight: 800; color: #0f2942;">
                                                <t t-out="'Br {:,.2f}'.format(doc.amount_total_etb)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </div>

                        <!-- Authorization & Signatures Block -->
                        <div class="mt-4 pt-2" style="page-break-inside: avoid; border-top: 1px dashed #cbd5e1;">
                            <div class="row text-center" style="font-size: 11px;">
                                <div class="col-4">
                                    <div style="color: #64748b; font-size: 10px; font-weight: 700; text-transform: uppercase; margin-bottom: 35px;">
                                        Prepared By (Procurement Officer)
                                    </div>
                                    <div style="border-top: 1px solid #0f2942; width: 85%; margin: 0 auto; padding-top: 4px;">
                                        <span t-field="doc.create_uid.name"/><br/>
                                        <small class="text-muted">Signature &amp; Date</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div style="color: #64748b; font-size: 10px; font-weight: 700; text-transform: uppercase; margin-bottom: 35px;">
                                        Verified By (Operations Manager)
                                    </div>
                                    <div style="border-top: 1px solid #0f2942; width: 85%; margin: 0 auto; padding-top: 4px;">
                                        <span t-if="doc.op_approved_by" t-field="doc.op_approved_by.name"/>
                                        <span t-else="" class="text-muted">Pending Verification</span><br/>
                                        <small class="text-muted">
                                            <t t-if="doc.op_approval_date">
                                                <span t-field="doc.op_approval_date" t-options='{"widget": "date"}'/>
                                            </t>
                                            <t t-else="">Signature &amp; Date</t>
                                        </small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div style="color: #64748b; font-size: 10px; font-weight: 700; text-transform: uppercase; margin-bottom: 35px;">
                                        Approved By (CEO / Executive)
                                    </div>
                                    <div style="border-top: 1px solid #0f2942; width: 85%; margin: 0 auto; padding-top: 4px;">
                                        <span t-if="doc.approved_by" t-field="doc.approved_by.name"/>
                                        <span t-else="" class="text-muted">Pending Approval</span><br/>
                                        <small class="text-muted">
                                            <t t-if="doc.approval_date">
                                                <span t-field="doc.approval_date" t-options='{"widget": "date"}'/>
                                            </t>
                                            <t t-else="">Signature &amp; Date</t>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Terms & Conditions Section -->
                        <div class="mt-4 pt-2" style="page-break-inside: avoid;">
                            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #0f2942; border-bottom: 1px solid #e2e8f0; padding-bottom: 3px; margin-bottom: 6px;">
                                Commercial Terms &amp; Import Instructions
                            </div>
                            <div style="font-size: 10px; color: #475569; line-height: 1.45;">
                                <div t-if="doc.terms_conditions">
                                    <span t-field="doc.terms_conditions"/>
                                </div>
                                <div t-else="">
                                    <p class="m-0">1. <strong>Quality &amp; Specifications:</strong> All spare parts must strictly conform to original manufacturer part numbers, specifications, and brand standards.</p>
                                    <p class="m-0">2. <strong>Packaging:</strong> Export seaworthy/airworthy packing suitable for international transit, clearly labeled with part numbers and quantities.</p>
                                    <p class="m-0">3. <strong>Required Shipping Documents:</strong> Signed Commercial Invoice, Detailed Packing List, Certificate of Origin, and Original Clean on Board Bill of Lading / Airway Bill.</p>
                                    <p class="m-0">4. <strong>Currency &amp; Banking:</strong> In accordance with National Bank of Ethiopia (NBE) foreign exchange import regulations.</p>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

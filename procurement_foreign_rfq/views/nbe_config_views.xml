<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_nbe_config_tree" model="ir.ui.view">
        <field name="name">nbe.config.tree</field>
        <field name="model">nbe.config</field>
        <field name="arch" type="xml">
            <list string="NBE Configurations">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nbe_config_form" model="ir.ui.view">
        <field name="name">nbe.config.form</field>
        <field name="model">nbe.config</field>
        <field name="arch" type="xml">
            <form string="NBE Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nbe_config" model="ir.actions.act_window">
        <field name="name">NBE Configurations</field>
        <field name="res_model">nbe.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_nbe_config" 
              name="NBE Configuration" 
              parent="account.menu_finance_configuration" 
              action="action_nbe_config" 
              groups="account.group_account_manager"
              sequence="100"/>
</odoo>

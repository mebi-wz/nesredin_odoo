<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_foreign_rfq_tree" model="ir.ui.view">
        <field name="name">foreign.rfq.tree</field>
        <field name="model">foreign.rfq</field>
        <field name="arch" type="xml">
            <list string="Foreign RFQs" decoration-info="state == 'draft'" decoration-warning="state in ('submitted', 'verified', 'pending_currency')" decoration-primary="state == 'approved'" decoration-danger="state == 'rejected'" decoration-success="state == 'po_created'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="requisition_id"/>
                <field name="requisition_ids" widget="many2many_tags" optional="show"/>
                <field name="date_rfq"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('submitted', 'verified', 'pending_currency')" decoration-primary="state == 'approved'" decoration-danger="state == 'rejected'" decoration-success="state == 'po_created'"/>
            </list>


        </field>
    </record>

    <record id="view_foreign_rfq_form" model="ir.ui.view">
        <field name="name">foreign.rfq.form</field>
        <field name="model">foreign.rfq</field>
        <field name="arch" type="xml">
            <form string="Foreign RFQ">
                <header>
                     <button name="action_approve" type="object" string="Submit" invisible="state != 'draft'" class="oe_highlight" groups="procurement_foreign_purchase.group_foreign_purchase_user"/>
                    <button name="action_approve" type="object" string="Verify" invisible="state != 'submitted'" class="oe_highlight" groups="procurement_foreign_purchase.group_foreign_purchase_manager"/>
                    <button name="action_approve" type="object" string="CEO Approve" invisible="state != 'verified'" class="oe_highlight" groups="procurement_foreign_purchase.group_foreign_purchase_ceo"/>
                    <button name="action_request_currency" type="object" string="Request Currency" invisible="state != 'pending_currency' or has_currency_request" class="oe_highlight" groups="procurement_foreign_purchase.group_foreign_purchase_manager"/>

                    <button name="action_create_po" string="Create Purchase Order" type="object" class="oe_highlight" invisible="state != 'approved'" groups="procurement_foreign_purchase.group_foreign_purchase_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('po_created','cancel','approved')" groups="procurement_foreign_purchase.group_foreign_purchase_manager"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ('rejected', 'cancel')" groups="procurement_foreign_purchase.group_foreign_purchase_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,verified,pending_currency,approved,po_created"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_order" type="object" class="oe_stat_button" icon="fa-credit-card"
                                invisible="not purchase_order_id"
                                groups="purchase.group_purchase_user">
                            <field name="po_count" widget="statinfo" string="Purchase Order"/>
                        </button>
                        <button name="action_view_currency_requests" type="object" class="oe_stat_button" icon="fa-credit-card"
                                invisible="currency_count == 0"
                                groups="account.group_account_invoice,purchase.group_purchase_manager,procurement_foreign_purchase.group_foreign_purchase_user">
                            <field name="currency_count" widget="statinfo" string="Currency Request"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="is_currency_approved" invisible="1"/>
                        <field name="has_currency_request" invisible="1"/>
                    </div>




                    <group>
                        <group>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="exchange_rate" readonly="state != 'draft'"/>
                            <field name="requisition_id"/>
                        </group>
                        <group>
                            <field name="date_rfq" readonly="state != 'draft'"/>
                            <field name="purchase_order_id" invisible="not purchase_order_id"/>
                           <field name="requisition_ids" widget="many2many_tags"/>
                           <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="cost_center_id" optional="show"/>
                                    <field name="estimated_cost"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                    <field name="price_unit_etb" readonly="1" decoration-muted="1"/>
                                    <field name="price_subtotal_etb" readonly="1" decoration-muted="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="HS Code" name="hs_code_tab">
                            <field name="line_ids" >
                                <list>
                                    <field name="line_no" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="hs_code"/>
                                    <field name="hs_description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Standard Cost" name="standard_cost_tab">
                            <notebook>
                                <page string="Estimated Standard Cost" name="est_standard_cost">
                                    <field name="line_ids" readonly="1">
                                        <list>
                                            <field name="line_no"/>
                                            <field name="product_id"/>
                                            <field name="quantity"/>
                                            <field name="uom_id"/>
                                            <field name="price_unit"/>
                                            <field name="price_subtotal"/>
                                            <field name="price_unit_etb"/>
                                            <field name="price_subtotal_etb"/>
                                        </list>
                                    </field>
                                </page>
                                <page string="Cost" name="cost_tab">
            
                                </page>
                            </notebook>
                        </page>
                        <page string="Proforma Invoice" name="proforma_invoice">
                            <group>
                                <group>
                                    <field name="proforma_invoice_no" required="state == 'to_approve'" readonly="state in ('approved', 'po_created')"/>
                                    <field name="proforma_invoice_date" required="state == 'to_approve'" readonly="state in ('approved', 'po_created')"/>
                                    <field name="incoterm" readonly="state in ('approved', 'po_created')"/>
                                    <field name="country_of_origin" readonly="state in ('approved', 'po_created')"/>

                                </group>
                                <group>
                                    <field name="mod_of_shipment" readonly="state in ('approved', 'po_created')"/>
                                    <field name="port_of_loading" readonly="state in ('approved', 'po_created')"/>
                                    <field name="port_of_discharge" readonly="state in ('approved', 'po_created')"/>
                                    <field name="port_of_final_destination" readonly="state in ('approved', 'po_created')"/>
                                    <field name="payment_terms" readonly="state in ('approved', 'po_created')"/>

                                </group>
                            </group>
                            <group string="Proforma Invoice Attachments">
                                <field name="pi_attachment_ids" widget="many2many_binary" readonly="state == 'po_created'"/>
                            </group>
                            <group string="Terms and Conditions">
                                <field name="terms_conditions" placeholder="Define custom terms and conditions for this RFQ..." readonly="state in ('approved', 'po_created')"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
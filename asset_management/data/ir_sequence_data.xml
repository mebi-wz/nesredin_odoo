<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_asset_major_category" model="ir.sequence">
        <field name="name">Asset Major Category</field>
        <field name="code">am.asset.major.category</field>
        <field name="prefix">MAJ</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_asset_minor_category" model="ir.sequence">
        <field name="name">Asset Minor Category</field>
        <field name="code">am.asset.minor.category</field>
        <field name="prefix">MIN</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_am_asset_handover_request" model="ir.sequence">
        <field name="name">Asset Handover Request</field>
        <field name="code">am.asset.handover.request</field>
        <field name="prefix">HO/%(range_year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_am_asset_temporary_request" model="ir.sequence">
        <field name="name">Asset Store Request</field>
        <field name="code">am.asset.temporary.request</field>
        <field name="prefix">STR/%(range_year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>

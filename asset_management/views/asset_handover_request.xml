<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         LIST VIEW
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_am_asset_handover_request_tree" model="ir.ui.view">
        <field name="name">am.asset.handover.request.tree</field>
        <field name="model">am.asset.handover.request</field>
        <field name="arch" type="xml">
            <list string="Handover Requests" create="1"
                  decoration-muted="state in ('draft', 'cancel')"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="name" decoration-bf="1"/>
                <field name="requested_by"/>
                <field name="to_employee_id"/>
                <field name="to_warehouse_id"/>
                <field name="requested_date" widget="date"/>
                <field name="approver_id" optional="show"/>
                <field name="approval_date" widget="date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-muted="state in ('draft', 'cancel')"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         FORM VIEW
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_am_asset_handover_request_form" model="ir.ui.view">
        <field name="name">am.asset.handover.request.form</field>
        <field name="model">am.asset.handover.request</field>
        <field name="arch" type="xml">
            <form string="Asset Handover Request" create="1">

                <!-- ── Header / State-Based Approval Workflow Buttons ─────────── -->
                <header>
                    <!-- Step 1: Requester submits -->
                    <button name="action_submit"
                            string="Submit for Approval"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <!-- Step 2: Manager approves -->
                    <button name="action_approve"
                            string="✔ Approve"
                            type="object"
                            class="btn-success"
                            groups="asset_management.group_asset_property_manager,asset_management.group_asset_manager,asset_management.group_asset_ffa_expert"
                            invisible="state != 'pending'"/>

                    <!-- Step 3: Manager rejects via reason wizard -->
                    <button name="action_open_reject_wizard"
                            string="✘ Reject"
                            type="object"
                            class="btn-danger"
                            groups="asset_management.group_asset_property_manager,asset_management.group_asset_manager,asset_management.group_asset_ffa_expert"
                            invisible="state != 'pending'"/>

                    <!-- Reset to Draft (from rejected or cancelled) -->
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('rejected', 'cancel')"/>

                    <!-- Cancel (from draft or pending) -->
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'pending')"/>

                    <!-- Print once approved -->
                    <button name="action_print_report"
                            string="🖨 Print Handover"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'approved'"/>

                    <!-- Statusbar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved"/>
                </header>

                <sheet>
                    <!-- Hidden helper fields for dynamic UI domains -->
                    <field name="is_property_manager" invisible="1"/>
                    <field name="allowed_asset_ids" invisible="1"/>
                    <field name="allowed_employee_ids" invisible="1"/>

                    <!-- ── Smart Buttons ───────────────────────────────── -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_print_report"
                                icon="fa-print"
                                invisible="state != 'approved'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Print</span>
                            </div>
                        </button>
                    </div>

                    <!-- ── Title ──────────────────────────────────────── -->
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- ── Main Fields ────────────────────────────────── -->
                    <group>
                        <group name="handover_details" string="Transfer Details">
                            <field name="asset_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Select assets to transfer..."
                                   readonly="state != 'draft'"/>
                            <field name="to_employee_id"
                                   string="Recipient Employee"
                                   options="{'no_create': True}"
                                   domain="[('id', 'in', allowed_employee_ids)]"
                                   invisible="to_warehouse_id"
                                   readonly="state != 'draft' and not is_property_manager"/>
                            <field name="to_warehouse_id"
                                   string="Target Warehouse"
                                   options="{'no_create': True}"
                                   invisible="to_employee_id"
                                   readonly="state != 'draft' and not is_property_manager"/>
                        </group>

                        <group name="request_info" string="Request Information">
                            <field name="requested_by" readonly="1"/>
                            <field name="requested_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="handover_type" readonly="state != 'draft'"/>
                            <field name="note"
                                   placeholder="Reason for transfer..."
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- ── Approval & Review Information ──────────────── -->
                    <group string="Approval &amp; Audit Information" invisible="state == 'draft'">
                        <group>
                            <field name="approver_id"/>
                            <field name="approval_date"/>
                        </group>
                        <group>
                            <field name="reject_reason" invisible="state != 'rejected'"/>
                        </group>
                    </group>

                    <!-- ── Notebook Tabs ──────────────────────────────── -->
                    <notebook>
                        <!-- TAB 1: Assets Table -->
                        <page string="Assets Being Transferred" name="assets_table">
                            <field name="asset_ids" nolabel="1" readonly="state != 'draft'">
                                <list>
                                    <field name="tag_number" string="Tag Number"/>
                                    <field name="name" string="Asset Name"/>
                                    <field name="major_category_id"/>
                                    <field name="minor_category_id"/>
                                    <field name="serial_number"/>
                                    <field name="status_id"/>
                                </list>
                            </field>
                        </page>

                        <!-- TAB 2: Recipient Signature (shown once approved) -->
                        <page string="Recipient Acknowledgement" name="signature_tab"
                              invisible="state != 'approved' or not to_employee_id">
                            <div class="o_horizontal_separator mt-3 mb-3 text-success fw-bold"
                                 style="font-size: 1.1em;">
                                <i class="fa fa-pen me-2" title="Signature"/> Recipient Confirmation
                            </div>
                            <group col="2">
                                <group>
                                    <field name="signed_by" readonly="signature"/>
                                    <field name="signature" widget="signature" readonly="signature"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                </sheet>

                <!-- Chatter -->
                <chatter/>

            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEARCH VIEW
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_am_asset_handover_request_search" model="ir.ui.view">
        <field name="name">am.asset.handover.request.search</field>
        <field name="model">am.asset.handover.request</field>
        <field name="arch" type="xml">
            <search string="Search Handover Requests">
                <field name="name" string="Reference"/>
                <field name="requested_by"/>
                <field name="to_employee_id"/>
                <field name="to_warehouse_id"/>
                <separator/>
                <filter string="Draft"            name="draft"         domain="[('state','=','draft')]"/>
                <filter string="Pending Approval" name="pending"       domain="[('state','=','pending')]"/>
                <filter string="Approved"         name="approved"      domain="[('state','=','approved')]"/>
                <filter string="Rejected"         name="rejected"      domain="[('state','=','rejected')]"/>
                <filter string="Cancelled"        name="cancelled"     domain="[('state','=','cancel')]"/>
                <group>
                    <filter string="Status"       name="by_state"     context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="by_requester" context="{'group_by': 'requested_by'}"/>
                    <filter string="Recipient"    name="by_recipient" context="{'group_by': 'to_employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         WINDOW ACTION
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="action_am_asset_handover_request" model="ir.actions.act_window">
        <field name="name">Asset Handover Requests</field>
        <field name="res_model">am.asset.handover.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new handover request</p>
            <p>Manage asset transfers between employees and warehouses with a full state-based approval workflow.</p>
        </field>
    </record>

    <!-- Action for the Approvals menu — managers review requests pending approval -->
    <record id="action_am_asset_handover_approval" model="ir.actions.act_window">
        <field name="name">Handover Requests – Pending Approval</field>
        <field name="res_model">am.asset.handover.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'draft')]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No handover requests awaiting review</p>
            <p>All submitted handover requests will appear here for approval.</p>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the Accounting Asset form to show a smart button linking back to the physical asset -->
    <record id="view_account_asset_asset_form_inherit_am" model="ir.ui.view">
        <field name="name">account.asset.asset.form.inherit.am</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="base_accounting_kit.account_asset_asset_view_form"/>
        <field name="arch" type="xml">
            <!-- Add Physical Asset smart button inside the existing button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_physical_asset" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="not physical_asset_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Physical</span>
                        <span class="o_stat_text">Asset</span>
                    </div>
                </button>
            </xpath>

            <!-- Add physical_asset_id read-only field to the form -->
            <xpath expr="//field[@name='invoice_id']" position="after">
                <field name="physical_asset_id" readonly="1"
                       invisible="not physical_asset_id"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="tag_number" readonly="1"
                       invisible="not tag_number"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit the Accounting Asset list/tree view to show Tag Number -->
    <record id="view_account_asset_asset_tree_inherit_am" model="ir.ui.view">
        <field name="name">account.asset.asset.tree.inherit.am</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="base_accounting_kit.account_asset_asset_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="tag_number" string="Tag Number" decoration-bf="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit the Accounting Asset kanban view to show Tag Number -->
    <record id="view_account_asset_asset_kanban_inherit_am" model="ir.ui.view">
        <field name="name">account.asset.asset.kanban.inherit.am</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="base_accounting_kit.account_asset_asset_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="tag_number"/>
            </xpath>
            <xpath expr="//div[hasclass('row')][1]" position="before">
                <div class="mb-1" t-if="record.tag_number.raw_value">
                    <span class="badge text-bg-light border text-primary fw-bold">
                        <i class="fa fa-tag me-1" title="Tag Number"/> <field name="tag_number"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

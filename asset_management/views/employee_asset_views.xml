<odoo>
    <!-- =====================================================
         SEARCH VIEW
    ===================================================== -->
    <record id="view_employee_asset_search" model="ir.ui.view">
        <field name="name">am.employee.asset.search</field>
        <field name="model">am.employee.asset</field>
        <field name="arch" type="xml">
            <search string="Search Employee Assets">
                <field name="employee_id" string="Employee"/>
                <field name="asset_id" string="Asset"/>
                <field name="tag_number" string="Tag Number"/>
                <field name="serial_number" string="Serial Number"/>
                <separator/>
                <filter string="Active Assignments" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Returned Assets" name="returned" domain="[('status', '=', 'returned')]"/>
                <filter string="Lost Assets" name="lost" domain="[('status', '=', 'lost')]"/>
                <group>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =====================================================
         TREE / LIST VIEW
    ===================================================== -->
    <record id="view_employee_asset_tree" model="ir.ui.view">
        <field name="name">am.employee.asset.tree</field>
        <field name="model">am.employee.asset</field>
        <field name="arch" type="xml">
            <list string="Employee Assets" create="0" edit="0" delete="0" default_order="employee_id asc">
                <header>
                    <button name="action_print_tag" string="🖨 Print Tag(s)" type="object" class="btn-secondary"/>
                </header>
                <field name="employee_id" widget="many2one_avatar" decoration-bf="1"/>
                <field name="asset_id" decoration-bf="1"/>
                <field name="category_id" optional="show"/>
                <field name="serial_number" optional="show"/>
                <field name="tag_number" string="Tag Number" decoration-bf="1"/>
                <field name="quantity"/>
                <field name="assigned_date"/>
                <field name="returned_date" optional="hide"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-muted="status == 'returned'" decoration-danger="status == 'lost'"/>
            </list>
        </field>
    </record>

    <!-- =====================================================
         FORM VIEW
    ===================================================== -->
    <record id="view_employee_asset_form" model="ir.ui.view">
        <field name="name">am.employee.asset.form</field>
        <field name="model">am.employee.asset</field>
        <field name="arch" type="xml">
            <form string="Employee Asset Assignment" create="0" edit="0" delete="0">
                <header>
                    <button name="action_print_tag" string="🖨 Print Tag" type="object" class="btn-secondary" icon="fa-print"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,returned,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="asset_id" class="oe_edit_only" string="Assigned Asset"/>
                        <h1>
                            <field name="asset_id" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="tag_number" class="text-muted" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group name="asset_info" string="Asset Details">
                            <field name="category_id"/>
                            <field name="serial_number"/>
                            <field name="tag_number"/>
                            <field name="asset_location"/>
                        </group>
                        <group name="assignment_info" string="Assignment Details">
                            <field name="employee_id" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="assigned_date" readonly="1"/>
                            <field name="returned_date" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- =====================================================
         KANBAN VIEW
    ===================================================== -->
    <record id="view_employee_asset_kanban" model="ir.ui.view">
        <field name="name">am.employee.asset.kanban</field>
        <field name="model">am.employee.asset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="employee_id" create="0" group_create="false" group_edit="false" group_delete="false" quick_create="false" records_draggable="false">
                <field name="id"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="tag_number"/>
                <field name="serial_number"/>
                <field name="assigned_date"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column">
                            <strong class="o_kanban_record_title"><field name="asset_id"/></strong>
                            <div class="text-muted mt-1">
                                <i class="fa fa-tag me-1" title="Tag Number"/> <field name="tag_number"/>
                            </div>
                            <div class="text-muted" t-if="record.serial_number.raw_value">
                                <span>S/N: </span><field name="serial_number"/>
                            </div>
                            <div class="mt-2">
                                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-muted="status == 'returned'" decoration-danger="status == 'lost'"/>
                            </div>
                            <div class="mt-2 text-muted" style="font-size: 0.85em;">
                                Assigned: <field name="assigned_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- =====================================================
         GRAPH VIEW
    ===================================================== -->
    <record id="view_employee_asset_graph" model="ir.ui.view">
        <field name="name">am.employee.asset.graph</field>
        <field name="model">am.employee.asset</field>
        <field name="arch" type="xml">
            <graph string="Assets by Employee" type="bar">
                <field name="employee_id" type="row"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- =====================================================
         ACTION
    ===================================================== -->
    <record id="action_employee_assets" model="ir.actions.act_window">
        <field name="name">Employee Assets</field>
        <field name="res_model">am.employee.asset</field>
        <field name="view_mode">kanban,list,form,graph</field>
        <field name="search_view_id" ref="view_employee_asset_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No asset assignments found!
            </p>
            <p>
                Assignments to employees are automatically generated when handover requests are approved.
            </p>
        </field>
    </record>
</odoo>

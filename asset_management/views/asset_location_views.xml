<odoo>
    <record id="view_asset_location_tree" model="ir.ui.view">
        <field name="name">am.asset.location.tree</field>
        <field name="model">am.asset.location</field>
        <field name="arch" type="xml">
            <list string="Locations">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="code"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_asset_location_form" model="ir.ui.view">
        <field name="name">am.asset.location.form</field>
        <field name="model">am.asset.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="warehouse_id"/>
                        <field name="code"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">am.asset.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define specific storage locations within each warehouse.
            </p>
        </field>
    </record>
</odoo>

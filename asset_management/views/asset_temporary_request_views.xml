<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════════════
         LIST VIEW
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_am_asset_temporary_request_tree" model="ir.ui.view">
        <field name="name">am.asset.temporary.request.tree</field>
        <field name="model">am.asset.temporary.request</field>
        <field name="arch" type="xml">
            <list string="Store Requests" create="1"
                  decoration-muted="state in ('draft', 'cancel')"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="name" decoration-bf="1"/>
                <field name="employee_id"/>
                <field name="requested_by" optional="show"/>
                <field name="requested_date" widget="date"/>
                <field name="return_date" widget="date"/>
                <field name="approver_id" optional="show"/>
                <field name="approval_date" widget="date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-muted="state in ('draft', 'cancel')"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         FORM VIEW
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_am_asset_temporary_request_form" model="ir.ui.view">
        <field name="name">am.asset.temporary.request.form</field>
        <field name="model">am.asset.temporary.request</field>
        <field name="arch" type="xml">
            <form string="Store Tool/Asset Request" create="1">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="✔ Approve" type="object" class="btn-success"
                            groups="asset_management.group_asset_property_manager,asset_management.group_asset_manager,asset_management.group_asset_ffa_expert"
                            invisible="state != 'pending'"/>
                    <button name="action_open_reject_wizard" string="✘ Reject" type="object" class="btn-danger"
                            groups="asset_management.group_asset_property_manager,asset_management.group_asset_manager,asset_management.group_asset_ffa_expert"
                            invisible="state != 'pending'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state not in ('rejected', 'cancel')"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                            invisible="state not in ('draft', 'pending')"/>
                    <button name="action_print_store_request" string="🖨 Print Request"
                            type="object" icon="fa-print" class="btn-secondary"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_print_store_request"
                                icon="fa-print"
                                invisible="state != 'approved'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Print</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="request_details" string="Request Details">
                            <field name="employee_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="asset_ids" widget="many2many_tags" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="return_date" readonly="state != 'draft'"/>
                        </group>
                        <group name="meta_info" string="Information">
                            <field name="requested_by" readonly="1"/>
                            <field name="requested_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="note" nolabel="1" placeholder="Why do you need these tools/assets?" readonly="state != 'draft'"/>
                    </group>

                    <!-- Approval & Review Information -->
                    <group string="Approval &amp; Audit Information" invisible="state == 'draft'">
                        <group>
                            <field name="approver_id"/>
                            <field name="approval_date"/>
                        </group>
                        <group>
                            <field name="reject_reason" invisible="state != 'rejected'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Requested Assets" name="assets">
                            <field name="asset_ids" nolabel="1" readonly="state != 'draft'">
                                <list>
                                    <field name="tag_number" string="Tag Number"/>
                                    <field name="name" string="Asset Name"/>
                                    <field name="major_category_id"/>
                                    <field name="serial_number"/>
                                    <field name="location"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEARCH VIEW
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_am_asset_temporary_request_search" model="ir.ui.view">
        <field name="name">am.asset.temporary.request.search</field>
        <field name="model">am.asset.temporary.request</field>
        <field name="arch" type="xml">
            <search string="Search Store Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter string="Draft"            name="draft"         domain="[('state','=','draft')]"/>
                <filter string="Pending Approval" name="pending"       domain="[('state','=','pending')]"/>
                <filter string="Approved"         name="approved"      domain="[('state','=','approved')]"/>
                <filter string="Rejected"         name="rejected"      domain="[('state','=','rejected')]"/>
                <filter string="Cancelled"        name="cancelled"     domain="[('state','=','cancel')]"/>
                <separator/>
                <filter string="To Return Soon" name="soon" domain="[('return_date', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Status"       name="by_state"     context="{'group_by': 'state'}"/>
                    <filter string="Employee"     name="by_employee"  context="{'group_by': 'employee_id'}"/>
                    <filter string="Requested By" name="by_requester" context="{'group_by': 'requested_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         WINDOW ACTIONS
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="action_am_asset_temporary_request" model="ir.actions.act_window">
        <field name="name">Store Requests</field>
        <field name="res_model">am.asset.temporary.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Request tools or assets from the store</p>
            <p>Employees can request assets from the warehouse for temporary use with state-based approval.</p>
        </field>
    </record>

    <!-- Action for the Approvals menu — managers review store requests pending approval -->
    <record id="action_am_asset_temporary_approval" model="ir.actions.act_window">
        <field name="name">Store Requests – Pending Approval</field>
        <field name="res_model">am.asset.temporary.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'draft')]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No store requests awaiting review</p>
            <p>All submitted store/temporary asset requests will appear here for approval.</p>
        </field>
    </record>
</odoo>

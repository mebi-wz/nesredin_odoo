<odoo>
    <record id="view_asset_warehouse_tree" model="ir.ui.view">
        <field name="name">am.asset.warehouse.tree</field>
        <field name="model">am.asset.warehouse</field>
        <field name="arch" type="xml">
            <list string="Warehouses">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="code"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_asset_warehouse_form" model="ir.ui.view">
        <field name="name">am.asset.warehouse.form</field>
        <field name="model">am.asset.warehouse</field>
        <field name="arch" type="xml">
            <form string="Warehouse">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_stock" type="object" class="oe_stat_button" icon="fa-cubes">
                            <div class="o_stat_info">
                                <field name="stock_count" class="o_stat_value"/>
                                <span class="o_stat_text">Assets</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="branch_id"/>
                        <field name="code"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                    <notebook>
                        <page string="Locations">
                            <field name="location_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_asset_warehouse" model="ir.actions.act_window">
        <field name="name">Warehouses</field>
        <field name="res_model">am.asset.warehouse</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage warehouses used for asset storage.
            </p>
        </field>
    </record>
</odoo>

<odoo>
    <!-- Add Asset Lists on Employee -->
    <record id="view_employee_form_inherit_assets" model="ir.ui.view">
        <field name="name">hr.employee.form.assets</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Employee Assets" groups="base.group_user">
                    <field name="employee_asset_ids" readonly="1">
                        <list string="Assets" create="0" edit="0" delete="0">
                            <field name="asset_id" decoration-bf="1"/>
                            <field name="tag_number" string="Tag Number" decoration-bf="1"/>
                            <field name="serial_number" optional="show"/>
                            <field name="assigned_date"/>
                            <field name="status" widget="badge" decoration-success="status == 'active'" decoration-muted="status == 'returned'" decoration-danger="status == 'lost'"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Add Asset Lists on Public Employee -->
    <record id="view_employee_public_form_inherit_assets" model="ir.ui.view">
        <field name="name">hr.employee.public.form.assets</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Employee Assets">
                    <field name="employee_asset_ids" readonly="1">
                        <list string="Assets" create="0" edit="0" delete="0">
                            <field name="asset_id" decoration-bf="1"/>
                            <field name="tag_number" string="Tag Number" decoration-bf="1"/>
                            <field name="serial_number" optional="show"/>
                            <field name="assigned_date"/>
                            <field name="status" widget="badge" decoration-success="status == 'active'" decoration-muted="status == 'returned'" decoration-danger="status == 'lost'"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>

<odoo>
    <data noupdate="0">
        <record id="module_category_asset_management" model="ir.module.category">
            <field name="name">Asset Management</field>
            <field name="sequence">10</field>
        </record>

        <!-- Privilege for Asset Management -->
        <record id="res_groups_privilege_asset_management" model="res.groups.privilege">
            <field name="name">Asset Management</field>
            <field name="category_id" ref="module_category_asset_management"/>
        </record>

        <!-- Asset User -->
        <record id="group_asset_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Asset Property Manager -->
        <record id="group_asset_property_manager" model="res.groups">
            <field name="name">Property Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_management"/>
            <field name="implied_ids" eval="[(4, ref('group_asset_user'))]"/>
        </record>

        <!-- Functional experts can operate assets -->
        <record id="group_asset_ffa_expert" model="res.groups">
            <field name="name">Fixed Asset Expert</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_management"/>
            <field name="implied_ids" eval="[(4, ref('group_asset_property_manager'))]"/>
        </record>

        <!-- Asset Manager -->
        <record id="group_asset_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_management"/>
            <field name="implied_ids" eval="[(4, ref('group_asset_ffa_expert'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Dashboard-only users can see aggregated asset information but
             cannot create, edit, or delete operational records. -->
        <record id="group_asset_dashboard_viewer" model="res.groups">
            <field name="name">Dashboard Read Only Viewer</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_asset_configuration_manager" model="res.groups">
            <field name="name">Configuration Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>

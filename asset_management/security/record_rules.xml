        <record id="rule_asset_company_visibility" model="ir.rule">
            <field name="name">Asset: multi-company</field>
            <field name="model_id" ref="model_am_asset"/>
            <field name="groups" eval="[(4, ref('group_asset_user')), (4, ref('group_asset_dashboard_viewer')), (4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>


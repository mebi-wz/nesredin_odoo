<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_local_payment_request_list" model="ir.ui.view">
        <field name="name">local.payment.request.list</field>
        <field name="model">local.payment.request</field>
        <field name="arch" type="xml">
            <list string="Payment Requests Without PO">
                <field name="name"/>
                <field name="requested_by"/>
                <field name="request_date"/>
                <field name="payment_type"/>
                <field name="total_amount"/>

                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('submitted', 'approved', 'budget_approved')" decoration-success="state in ('authorized', 'paid')"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_local_payment_request_form" model="ir.ui.view">
        <field name="name">local.payment.request.form</field>
        <field name="model">local.payment.request</field>
        <field name="arch" type="xml">
            <form string="Payment Request Without PO">
                <header>
                    <button name="action_submit" type="object" string="SUBMIT" class="oe_highlight" invisible="state != 'draft'" groups="procurement_store_requisition.group_store_requisition_user"/>
                    <button name="action_approve" type="object" string="APPROVE" class="oe_highlight" invisible="state != 'submitted'" groups="procurement_local_purchase.group_local_purchase_dept_manager"/>
                    <button name="action_budget_approve" type="object" string="BUDGET APPROVE" class="oe_highlight" invisible="state != 'approved'" groups="procurement_store_requisition.group_store_requisition_budget_manager"/>
                    <button name="action_authorize" type="object" string="AUTHORIZE" class="oe_highlight" invisible="state != 'budget_approved'" groups="procurement_local_purchase.group_local_purchase_pr_manager"/>
                    <button name="action_cancel" type="object" string="CANCEL" invisible="state in ('authorized', 'paid', 'cancelled')" groups="procurement_local_purchase.group_local_purchase_dept_manager"/>
                    <button name="action_draft" type="object" string="SET TO DRAFT" invisible="state != 'cancelled'" groups="procurement_store_requisition.group_store_requisition_user"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,budget_approved,authorized,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment" type="object" class="oe_stat_button" icon="fa-money" invisible="not payment_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Payment</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Payment Request</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="payment_type" readonly="state != 'draft'"/>
                            <field name="requested_by" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="cost_center_id" readonly="state != 'draft'"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="purpose" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>

                        </group>
                    </group>
                    
                    <group>
                        <group string="PAY TO">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="payment_due_date" readonly="state != 'draft'"/>
                        </group>
                        <group string="AMOUNT">
                            <field name="total_amount" readonly="state != 'draft'"/>

                            <field name="amount_in_word" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="BUDGET CATEGORY">
                        <group>
                            <field name="budget_category_id" readonly="state != 'draft'"/>
                            <field name="budget_account_id" readonly="state != 'draft'"/>
                            <field name="remaining_balance" readonly="state != 'draft'"/>
                            <field name="payment_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_local_payment_request" model="ir.actions.act_window">
        <field name="name">Payment Request Without PO</field>
        <field name="res_model">local.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Payment Request Without PO.
            </p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_inventory_valuation_journal_items" model="ir.actions.act_window">
        <field name="name">Inventory Valuation Journal Entries</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph,kanban</field>
        <field name="domain">[('journal_id.code', '=', 'STJ'), ('display_type', 'not in', ('line_section', 'line_subsection', 'line_note')), ('parent_state', '!=', 'cancel')]</field>
        <field name="context">{'journal_type': 'general', 'search_default_group_by_move': 1, 'search_default_posted': 1}</field>
        <field name="search_view_id" ref="account.view_account_move_line_filter"/>
    </record>

    <menuitem id="menu_action_inventory_valuation_journal_items"
              name="Inventory Valuation"
              action="action_inventory_valuation_journal_items"
              parent="account.account_audit_control_menu"
              groups="account.group_account_readonly"
              sequence="10"/>
</odoo>

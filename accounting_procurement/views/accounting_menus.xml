<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================== -->
    <!-- PO MARGINS                                               -->
    <!-- ======================================================== -->
    <record id="view_purchase_import_margin_list_accounting" model="ir.ui.view">
        <field name="name">purchase.import.margin.list.accounting</field>
        <field name="model">purchase.import.margin</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Margins">
                <field name="import_id" required="1"/>
                <field name="margin_order"/>
                <field name="margin_percent" sum="Total %"/>
                <field name="calculation"/>
                <field name="usd_amount" string="USD" sum="Total USD"/>
                <field name="exchange_rate"/>
                <field name="etb_amount" string="ETB" sum="Total ETB"/>
                <field name="account_id"/>
                <field name="lc_reference" options="{'no_create': True, 'no_open': True}"/>
                <field name="move_reference" string="Move"/>
                <button name="action_create_bill" type="object" string="CREATE BILL" class="oe_highlight btn-sm" invisible="move_reference"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_import_margin_form_accounting" model="ir.ui.view">
        <field name="name">purchase.import.margin.form.accounting</field>
        <field name="model">purchase.import.margin</field>
        <field name="arch" type="xml">
            <form string="Margin">
                <header>
                    <button name="action_create_bill" type="object" string="CREATE BILL" class="oe_highlight" invisible="move_reference"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="import_id" required="1"/>
                            <field name="margin_order"/>
                            <field name="calculation"/>
                            <field name="margin_percent"/>
                        </group>
                        <group>
                            <field name="usd_amount" string="USD"/>
                            <field name="exchange_rate"/>
                            <field name="etb_amount" string="ETB"/>
                            <field name="account_id"/>
                            <field name="lc_reference"/>
                            <field name="move_reference"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_import_margin_accounting" model="ir.actions.act_window">
        <field name="name">PO Margins</field>
        <field name="res_model">purchase.import.margin</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Purchase Import Margin
            </p>
        </field>
    </record>

    <menuitem id="menu_account_vendor_purchase_order"
              name="Purchase Orders"
              parent="account.menu_finance_payables"
              sequence="210"/>

    <menuitem id="menu_purchase_import_margin_accounting"
              name="PO Margins"
              action="action_purchase_import_margin_accounting"
              parent="menu_account_vendor_purchase_order"
              sequence="30"/>

    <!-- ======================================================== -->
    <!-- PURCHASE ORDERS (LOCAL & FOREIGN)                        -->
    <!-- ======================================================== -->
    <record id="action_account_local_po" model="ir.actions.act_window">
        <field name="name">Local Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar,activity</field>
        <field name="domain">[('request_type', '=', 'local')]</field>
        <field name="context">{'default_request_type': 'local'}</field>
    </record>

    <record id="action_account_foreign_po" model="ir.actions.act_window">
        <field name="name">Foreign Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar,activity</field>
        <field name="domain">[('request_type', '=', 'foreign')]</field>
        <field name="context">{'default_request_type': 'foreign'}</field>
    </record>


    <menuitem id="menu_account_vendor_local_po"
              name="Local"
              parent="menu_account_vendor_purchase_order"
              action="action_account_local_po"
              sequence="10"/>

    <menuitem id="menu_account_vendor_foreign_po"
              name="Foreign"
              parent="menu_account_vendor_purchase_order"
              action="action_account_foreign_po"
              sequence="20"/>

    <!-- ======================================================== -->
    <!-- APPROVALS MENU                                           -->
    <!-- ======================================================== -->
    <menuitem id="menu_accounting_approvals"
              name="Approvals"
              parent="account.menu_finance"
              sequence="7"/>

    <menuitem id="menu_accounting_payment_request_parent"
              name="Payment Request"
              parent="menu_accounting_approvals"
              sequence="10"/>

    <menuitem id="menu_accounting_payment_request"
              name="Payment Request - Foreign"
              parent="menu_accounting_payment_request_parent"
              action="procurement_foreign_operations.action_foreign_payment_request"
              sequence="10"/>

    <menuitem id="menu_accounting_payment_request_local"
              name="Payment Request - Local"
              parent="menu_accounting_payment_request_parent"
              action="procurement_local_purchase.action_local_payment_request"
              sequence="15"/>

    <menuitem id="menu_accounting_purchase_request_local"
              name="Purchase Request - Local"
              parent="menu_accounting_payment_request_parent"
              action="procurement_local_purchase.action_local_purchase_requisitions"
              sequence="20"/>

    <menuitem id="menu_accounting_purchase_request_foreign"
              name="Purchase Request - Foregin"
              parent="menu_accounting_payment_request_parent"
              action="procurement_foreign_purchase.action_foreign_purchase_requisition"
              sequence="30"/>

    <menuitem id="menu_accounting_foreign_currency_request"
              name="Foreign Currency Request"
              parent="menu_accounting_payment_request_parent"
              action="procurement_foreign_rfq.action_procurement_currency_request"
              sequence="40"/>

    <record id="action_accounting_credit_sales_approval" model="ir.actions.act_window">
        <field name="name">Credit Sales Approval</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'finance_approval')]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_accounting_credit_sales_approval"
              name="Credit Sales"
              parent="menu_accounting_approvals"
              action="action_accounting_credit_sales_approval"
              sequence="50"/>

    <menuitem id="menu_accounting_inventory_adjustments_approval"
              name="Physical Inventory"
              parent="menu_accounting_approvals"
              action="stock.action_view_inventory_tree"
              sequence="60"/>

    <!-- ======================================================== -->
    <!-- PROCUREMENT / PURCHASE INVOICING & PAYMENTS MENUS        -->
    <!-- (Added to Purchase module without altering Accounting)   -->
    <!-- ======================================================== -->
    <menuitem id="menu_purchase_invoicing_root"
              name="Invoicing"
              parent="purchase.menu_purchase_root"
              sequence="20"/>

    <menuitem id="menu_purchase_vendor_bills"
              name="Bills"
              parent="menu_purchase_invoicing_root"
              action="account.action_move_in_invoice"
              sequence="10"/>

    <menuitem id="menu_purchase_vendor_refunds"
              name="Refunds"
              parent="menu_purchase_invoicing_root"
              action="account.action_move_in_refund_type"
              sequence="20"/>

    <menuitem id="menu_purchase_vendor_margins"
              name="Bill Margins"
              parent="menu_purchase_invoicing_root"
              action="action_purchase_import_margin_accounting"
              sequence="30"/>

    <menuitem id="menu_purchase_vendor_payments"
              name="Payments"
              parent="menu_purchase_invoicing_root"
              action="account.action_account_payments_payable"
              sequence="40"/>

    <!-- Also expose Bill Margins directly under Foreign Procurement -->
    <menuitem id="menu_purchase_foreign_margins"
              name="Bill Margins"
              parent="procurement_base.menu_foreign_purchase_root"
              action="action_purchase_import_margin_accounting"
              sequence="25"/>

    <!-- ======================================================== -->
    <!-- BANK TRANSACTIONS (JOURNAL ENTRIES PER BANK)             -->
    <!-- ======================================================== -->
    <record id="view_move_tree_bank_transactions" model="ir.ui.view">
        <field name="name">account.move.list.bank.transactions</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Bank Transactions" sample="1" decoration-info="state == 'draft'" expand="context.get('expand', False)">
                <field name="company_currency_id" column_invisible="True"/>
                <field name="made_sequence_gap" column_invisible="True"/>
                <field name="invoice_date" string="Invoice Date" optional="hide" readonly="state != 'draft'"/>
                <field name="date" readonly="state in ['cancel', 'posted']"/>
                <field name="name" string="Number" decoration-danger="made_sequence_gap and state == 'posted'" widget="char_with_placeholder_field_to_check" placeholder="/" readonly="state != 'draft'"/>
                <field name="checked" column_invisible="True" groups="account.group_account_user"/>
                <field name="partner_id" optional="show" readonly="state != 'draft'"/>
                <field name="ref" string="Reference" optional="show"/>
                <field name="journal_id" string="Bank"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="bank_amount_signed" sum="Total Amount" string="Amount" decoration-bf="1" decoration-danger="bank_amount_signed &lt; 0" decoration-success="bank_amount_signed &gt; 0"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'"/>
                <field name="currency_id" column_invisible="True" readonly="state in ['cancel', 'posted']"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_bank_transactions_journal_entries" model="ir.actions.act_window">
        <field name="name">Bank Transactions</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_move_tree_bank_transactions"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('journal_id.type', '=', 'bank')]</field>
        <field name="context">{
            'default_move_type': 'entry',
            'search_default_bankoperations': 1,
            'search_default_journal': 1,
        }</field>
        <field name="group_ids" eval="[(4, ref('accounting_procurement.group_bank_transactions_access'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bank transactions found
            </p>
            <p>
                Bank transactions recorded as journal entries will appear here, grouped per bank.
            </p>
        </field>
    </record>

    <!-- Bank Transactions under Sales -> Invoicing -->
    <menuitem id="menu_sale_bank_transactions"
              name="Bank Transactions"
              parent="sale.menu_sale_invoicing"
              action="action_bank_transactions_journal_entries"
              groups="accounting_procurement.group_bank_transactions_access"
              sequence="4"/>

    <!-- Bank Transactions under Purchase -> Invoicing -->
    <menuitem id="menu_purchase_bank_transactions"
              name="Bank Transactions"
              parent="menu_purchase_invoicing_root"
              action="action_bank_transactions_journal_entries"
              groups="accounting_procurement.group_bank_transactions_access"
              sequence="50"/>

    <!-- Bank Transactions under Accounting -> Transactions -->
    <menuitem id="menu_accounting_bank_transactions"
              name="Bank Transactions"
              parent="account.account_transactions_menu"
              action="action_bank_transactions_journal_entries"
              groups="accounting_procurement.group_bank_transactions_access"
              sequence="2"/>
</odoo>

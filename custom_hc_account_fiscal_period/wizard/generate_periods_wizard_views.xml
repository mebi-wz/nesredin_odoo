<odoo>
    <record id="view_generate_fiscal_periods_wizard_form" model="ir.ui.view">
        <field name="name">account.fiscal.period.generate.wizard.form</field>
        <field name="model">account.fiscal.period.generate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="fiscal_year_id" invisible="1"/>
                <group>
                    <field name="number_of_periods"/>
                    <field name="overwrite_existing"/>
                </group>
                <group>
                    <field name="period_names" nolabel="1" placeholder="Hamle 2018&#10;Nehase 2018&#10;Meskerem 2018&#10;..."/>
                </group>
                <footer>
                    <button string="Generate" type="object" name="action_generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_fiscal_periods_wizard" model="ir.actions.act_window">
        <field name="name">Generate Periods</field>
        <field name="res_model">account.fiscal.period.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

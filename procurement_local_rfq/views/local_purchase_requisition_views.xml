<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_local_purchase_requisition_form_inherit_rfq" model="ir.ui.view">
        <field name="name">local.purchase.requisition.form.inherit.rfq</field>
        <field name="model">local.purchase.requisition</field>
        <field name="inherit_id" ref="procurement_local_purchase.view_local_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <!-- Add Create RFQ Button -->
            <xpath expr="//button[@name='action_create_po']" position="before">
                <button name="action_create_rfq" type="object"
                        string="Create RFQ"
                        invisible="state != 'approved' or procurement_method != 'rfq' or rfq_count > 0"
                        class="oe_highlight"/>
            </xpath>
            
            <!-- Add RFQ Smart Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rfqs" type="object" class="oe_stat_button" icon="fa-list-alt" invisible="rfq_count == 0">
                    <field name="rfq_count" widget="statinfo" string="RFQs"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>

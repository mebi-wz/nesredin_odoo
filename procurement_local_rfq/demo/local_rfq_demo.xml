<odoo>
    <!-- Warehouses and Locations -->
    <record id="warehouse_demo" model="stock.warehouse">
        <field name="name">Main Warehouse</field>
        <field name="code">WH/MAIN</field>
    </record>

    <!-- Partners (vendors/customers not strictly needed for store requisition) -->
    <record id="user_demo" model="res.users">
        <field name="name">Demo User rfq</field>
        <field name="login">demo2</field>
    </record>

    <!-- Departments -->
    <record id="dept_it" model="hr.department">
        <field name="name">IT Department</field>
    </record>

    <!-- Products -->
    <record id="product_laptop" model="product.product">
        <field name="name">Laptop</field>
        <field name="type">consu</field> 
        <field name="standard_price">1200</field>
    </record>
    <record id="product_mouse" model="product.product">
        <field name="name">Mouse</field>
        <field name="type">consu</field>
        <field name="standard_price">25</field>
    </record>

    <!-- Store Requisition -->
    <record id="store_req_demo" model="store.requisition">
        <field name="name">MTIV/OF/26/00001</field>
        <field name="warehouse_id" ref="warehouse_demo"/>
        <field name="requested_by" ref="user_demo"/>
        <field name="request_type">local</field>
        <field name="product_type">technical</field>
        <field name="purpose">Demo store requisition for IT equipment</field>
        <field name="state">draft</field>
    </record>

    <!-- Store Requisition Lines -->
    <record id="store_line_laptop" model="store.requisition.line">
        <field name="requisition_id" ref="store_req_demo"/>
        <field name="product_id" ref="product_laptop"/>
        <field name="quantity">2</field>
    </record>
    <record id="store_line_mouse" model="store.requisition.line">
        <field name="requisition_id" ref="store_req_demo"/>
        <field name="product_id" ref="product_mouse"/>
        <field name="quantity">5</field>
    </record>

    <!-- Optional: Create a Picking (SIV) for demo -->
    <record id="picking_demo" model="stock.picking">
    <field name="picking_type_id" ref="stock.picking_type_internal"/> 
    <field name="location_id" ref="stock.stock_location_stock"/>
    <field name="location_dest_id" ref="stock.stock_location_customers"/> 
    <field name="origin">MTIV/OF/26/00001</field>
    <field name="store_requisition_id" ref="store_req_demo"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_foreign_purchase" model="ir.module.category">
        <field name="name">Procurement</field>
        <field name="description">Helps you manage procurement foreign purchase</field>
        <field name="sequence">10</field>
    </record>

     <!-- Privileges for checkboxes - Reference the shared category from store_requisition -->
        <record id="privilege_foreign_purchase_user" model="res.groups.privilege">
            <field name="name">Foreign Purchase: User</field>
            <field name="category_id" ref="category_foreign_purchase"/>
            <field name="sequence">50</field>
        </record>

        <record id="privilege_foreign_purchase_manager" model="res.groups.privilege">
            <field name="name">Foreign Purchase: Manager</field>
            <field name="category_id" ref="category_foreign_purchase"/>
            <field name="sequence">60</field>
        </record>

        <record id="privilege_foreign_purchase_analysis" model="res.groups.privilege">
            <field name="name">Foreign Purchase: Analysis</field>
            <field name="category_id" ref="category_foreign_purchase"/>
            <field name="sequence">70</field>
        </record>

        <!-- New Groups for Foreign Purchase -->
        <record id="group_foreign_purchase_user" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_foreign_purchase_user"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">1</field>
        </record>

        <record id="group_foreign_purchase_manager" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_foreign_purchase_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_foreign_purchase_user'))]"/>
            <field name="sequence">1</field>
        </record>

        <record id="group_foreign_purchase_analysis" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_foreign_purchase_analysis"/>
            <field name="implied_ids" eval="[(4, ref('group_foreign_purchase_user'))]"/>
            <field name="sequence">1</field>
        </record>
        <record id="privilege_foreign_purchase_budget" model="res.groups.privilege">
            <field name="name">Foreign Purchase: Budget</field>
            <field name="category_id" ref="category_foreign_purchase"/>
            <field name="sequence">80</field>
        </record>

        <record id="group_foreign_purchase_budget" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_foreign_purchase_budget"/>
            <field name="implied_ids" eval="[(4, ref('group_foreign_purchase_user'))]"/>
            <field name="sequence">1</field>
        </record>

        <record id="privilege_foreign_purchase_operation_manager" model="res.groups.privilege">
            <field name="name">Foreign Purchase: Operation Manager</field>
            <field name="category_id" ref="category_foreign_purchase"/>
            <field name="sequence">85</field>
        </record>

        <record id="group_foreign_purchase_operation_manager" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_foreign_purchase_operation_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_foreign_purchase_user'))]"/>
            <field name="sequence">1</field>
        </record>


        <record id="privilege_foreign_purchase_ceo" model="res.groups.privilege">
            <field name="name">Foreign Purchase: CEO</field>
            <field name="category_id" ref="category_foreign_purchase"/>
            <field name="sequence">90</field>
        </record>

        <record id="group_foreign_purchase_ceo" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_foreign_purchase_ceo"/>
            <field name="implied_ids" eval="[(4, ref('group_foreign_purchase_user'))]"/>
            <field name="sequence">1</field>
        </record>
</odoo>

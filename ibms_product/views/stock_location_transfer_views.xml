<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================= -->
    <!-- Tree / List View for Location Transfers                   -->
    <!-- ========================================================= -->
    <record id="view_stock_location_transfer_tree" model="ir.ui.view">
        <field name="name">stock.location.transfer.list</field>
        <field name="model">stock.location.transfer</field>
        <field name="arch" type="xml">
            <list string="Location Transfers" multi_edit="1" sample="1">
                <field name="name" string="Transfer #" decoration-bf="1"/>
                <field name="date" string="Date" widget="date"/>
                <field name="source_analytic_account_id" string="Source Analytic Account" optional="show"/>
                <field name="source_warehouse_id" string="Source Warehouse"/>
                <field name="dest_analytic_account_id" string="Destination Analytic Account" optional="show"/>
                <field name="dest_warehouse_id" string="Destination Warehouse"/>
                <field name="requested_by_id" string="Requested By" widget="many2one_avatar_user"/>
                <field name="sent_by_id" string="Sent By" widget="many2one_avatar_user" optional="show"/>
                <field name="received_by_id" string="Received By" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" string="Status" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-info="state in ('approved', 'in_transit')"
                       decoration-success="state == 'received'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Form View for Location Transfers                          -->
    <!-- ========================================================= -->
    <record id="view_stock_location_transfer_form" model="ir.ui.view">
        <field name="name">stock.location.transfer.form</field>
        <field name="model">stock.location.transfer</field>
        <field name="arch" type="xml">
            <form string="Location Transfer">
                <header>
                    <!-- Step 0: Requester submits -->
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <!-- Step 1: Manager approves — creates picking, doesn't validate -->
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-success"
                            invisible="state != 'submitted'"/>

                    <!-- Step 2: Source warehouse staff marks items as sent -->
                    <button name="action_send" type="object" string="Mark as Sent"
                            class="btn-primary"
                            confirm="Confirm that all items have been physically packed and dispatched from the source warehouse?"
                            invisible="state != 'approved'"/>

                    <!-- Step 3: Destination warehouse staff confirms receipt -->
                    <button name="action_receive" type="object" string="Confirm Receipt"
                            class="btn-success"
                            confirm="Confirm that all items have been physically received at the destination warehouse?"
                            invisible="state != 'in_transit'"/>

                    <!-- Cancel (allowed in draft, submitted, approved, in_transit) -->
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('received', 'cancel')"/>

                    <!-- Print Official Transfer Slip / Waybill -->
                    <button name="action_print_transfer_slip" type="object" string="Print Slip"
                            class="btn-secondary" icon="fa-print"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,in_transit,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Stock Move</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1 class="d-flex">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="From (Source)">
                            <field name="source_analytic_account_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="source_warehouse_id"
                                   domain="[('analytic_account_id', '=', source_analytic_account_id)]"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="To (Destination)">
                            <field name="dest_analytic_account_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="dest_warehouse_id"
                                   domain="[('analytic_account_id', '=', dest_analytic_account_id)]"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Details">
                            <field name="date"/>
                            <field name="requested_by_id" widget="many2one_avatar_user"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <!-- Dispatch & Receipt tracking (visible once in transit) -->
                        <group string="Dispatch &amp; Receipt" invisible="state not in ('in_transit', 'received')">
                            <field name="sent_by_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="sent_date" readonly="1"/>
                            <field name="received_by_id" widget="many2one_avatar_user" readonly="1"
                                   invisible="state != 'received'"/>
                            <field name="received_date" readonly="1"
                                   invisible="state != 'received'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products to Transfer" name="products">
                            <field name="line_ids"
                                   readonly="state not in ('draft',)">
                                <list editable="bottom" string="Products">
                                    <field name="image_1920" string="Image" widget="image" options="{'zoom': true, 'preview_image': 'image_128', 'size': [40, 40]}" width="45" optional="show" readonly="1"/>
                                    <field name="product_id" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                                    <field name="default_code" string="Product Code" optional="show" readonly="1"/>
                                    <field name="part_number" string="Part Number" optional="show" readonly="1"/>
                                    <field name="secondary_parts_display" string="Secondary Part Numbers" optional="hide" readonly="1"/>
                                    <field name="description" optional="show"/>
                                    <field name="product_uom_qty" string="Quantity"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note" placeholder="Add instructions or remarks for this transfer..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Search View for Location Transfers                        -->
    <!-- ========================================================= -->
    <record id="view_stock_location_transfer_search" model="ir.ui.view">
        <field name="name">stock.location.transfer.search</field>
        <field name="model">stock.location.transfer</field>
        <field name="arch" type="xml">
            <search string="Search Location Transfers">
                <field name="name" string="Transfer #"/>
                <field name="source_warehouse_id"/>
                <field name="dest_warehouse_id"/>
                <field name="requested_by_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="In Transit" name="in_transit" domain="[('state', '=', 'in_transit')]"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Cancelled" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <group>
                    <filter string="Source Warehouse" name="group_by_source_wh" context="{'group_by': 'source_warehouse_id'}"/>
                    <filter string="Destination Warehouse" name="group_by_dest_wh" context="{'group_by': 'dest_warehouse_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="group_by_requester" context="{'group_by': 'requested_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Window Action                                             -->
    <!-- ========================================================= -->
    <record id="action_stock_location_transfer" model="ir.actions.act_window">
        <field name="name">Location Transfers</field>
        <field name="res_model">stock.location.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_location_transfer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Location Transfer
            </p>
            <p>
                Request and execute stock transfers between central warehouse, shops, and branch locations.
            </p>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Top Header Navigation Menu Item                           -->
    <!-- ========================================================= -->
    <menuitem id="menu_stock_location_transfers"
              name="Location Transfers"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_location_transfer"
              sequence="2"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Warehouse Stock List View (Strictly View-Only) -->
    <record id="view_main_warehouse_stock_list" model="ir.ui.view">
        <field name="name">main.warehouse.stock.list</field>
        <field name="model">main.warehouse.stock</field>
        <field name="arch" type="xml">
            <list string="Main Warehouse Stock" create="false" edit="false" delete="false">
                <field name="image_128" widget="image" options="{'zoom': true, 'preview_image': 'image_128', 'size': [40, 40]}" width="45" string="Image"/>
                <field name="default_code" string="Product Code"/>
                <field name="part_number" string="Primary Part #"/>
                <field name="secondary_parts_display" string="Secondary Part Numbers" optional="show"/>
                <field name="product_id" string="Product Name"/>
                <field name="categ_id" string="Category" optional="show"/>
                <field name="location_id" string="Location / Rack"/>
                <field name="quantity" string="On Hand" sum="Total On Hand"/>
                <field name="reserved_quantity" string="Reserved" optional="show" sum="Total Reserved"/>
                <field name="available_quantity" string="Available to Use" decoration-success="available_quantity &gt; 0" decoration-danger="available_quantity &lt;= 0" sum="Total Available"/>
                <field name="uom_id" string="UoM"/>
                <button name="action_view_product" type="object" string="Product" icon="fa-external-link" title="Open Product Details" class="btn-sm btn-link"/>
            </list>
        </field>
    </record>

    <!-- Main Warehouse Stock Form View (Strictly View-Only) -->
    <record id="view_main_warehouse_stock_form" model="ir.ui.view">
        <field name="name">main.warehouse.stock.form</field>
        <field name="model">main.warehouse.stock</field>
        <field name="arch" type="xml">
            <form string="Main Warehouse Stock Details" create="false" edit="false" delete="false">
                <header>
                    <button name="action_print_stock_report" type="object" string="Print Stock Sheet" class="btn-primary" icon="fa-print"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_product" type="object" class="oe_stat_button" icon="fa-cube" string="View Product"/>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar" options="{'zoom': true}"/>
                    <div class="oe_title">
                        <label for="product_id" string="Product"/>
                        <h1><field name="product_id" readonly="1"/></h1>
                        <h3>
                            <span class="text-muted">Code: </span><field name="default_code" readonly="1" class="oe_inline"/>
                            <span class="text-muted ms-3">Primary Part #: </span><field name="part_number" readonly="1" class="oe_inline"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Inventory in Main Warehouse">
                            <field name="warehouse_id" readonly="1"/>
                            <field name="location_id" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="reserved_quantity" readonly="1"/>
                            <field name="available_quantity" readonly="1" decoration-success="available_quantity &gt; 0"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                        <group string="Product Classification">
                            <field name="categ_id" readonly="1"/>
                            <field name="secondary_parts_display" readonly="1" invisible="not secondary_parts_display"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Main Warehouse Stock Search & Filter View -->
    <record id="view_main_warehouse_stock_search" model="ir.ui.view">
        <field name="name">main.warehouse.stock.search</field>
        <field name="model">main.warehouse.stock</field>
        <field name="arch" type="xml">
            <search string="Search Main Warehouse Stock">
                <field name="product_id" string="Product / Code / Part #" filter_domain="['|', '|', '|', ('default_code', 'ilike', self), ('product_id', 'ilike', self), ('part_number', 'ilike', self), ('secondary_parts_display', 'ilike', self)]"/>
                <field name="default_code" string="Product Code"/>
                <field name="part_number" string="Part Number (Primary &amp; Secondary)" filter_domain="['|', ('part_number', 'ilike', self), ('secondary_parts_display', 'ilike', self)]"/>
                <field name="secondary_parts_display" string="Secondary Part Numbers"/>
                <field name="location_id" string="Location / Rack"/>
                <group>
                    <filter string="In Stock Only" name="filter_available" domain="[('available_quantity', '&gt;', 0)]"/>
                    <filter string="Has Reserved Stock" name="filter_reserved" domain="[('reserved_quantity', '&gt;', 0)]"/>
                </group>
                <group>
                    <filter string="Category" name="group_by_categ" context="{'group_by': 'categ_id'}"/>
                    <filter string="Location / Rack" name="group_by_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Warehouse Stock Window Action -->
    <record id="action_main_warehouse_stock" model="ir.actions.act_window">
        <field name="name">Main Warehouse Stock</field>
        <field name="res_model">main.warehouse.stock</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_main_warehouse_stock_list"/>
        <field name="search_view_id" ref="view_main_warehouse_stock_search"/>
        <field name="context">{'search_default_filter_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock found in the Main Warehouse.
            </p>
            <p>
                This screen provides real-time, view-only visibility of all available quantities and locations inside the central warehouse.
            </p>
        </field>
    </record>

    <!-- Menuitem in Inventory Operations -->
    <menuitem id="menu_main_warehouse_stock_inventory"
              name="Main Warehouse Stock"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_main_warehouse_stock"
              sequence="12"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ibms_warehouse" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ibms.warehouse</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="warehouse_id"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt', 'in_invoice', 'in_refund', 'in_receipt')"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>

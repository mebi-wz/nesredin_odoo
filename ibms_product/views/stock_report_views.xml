<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================== -->
    <!-- 1. Inventory > Reporting > Stock (product.product)        -->
    <!-- ======================================================== -->
    <record id="product_product_stock_tree_inherit_ibms" model="ir.ui.view">
        <field name="name">product.product.stock.list.inherit.ibms</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="before">
                <field name="image_1920"
                       string="Image"
                       widget="image"
                       options="{'zoom': true, 'preview_image': 'image_128', 'size': [40, 40]}"
                       width="45"
                       optional="show"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="part_number" string="Part Number" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Search View for Stock Report -->
    <record id="product_search_form_view_stock_report_inherit_ibms" model="ir.ui.view">
        <field name="name">product.product.search.stock.form.stock.report.inherit.ibms</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_search_form_view_stock_report"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="part_number" string="Part Number" filter_domain="[('part_number', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================= -->
    <!-- Dedicated List View for Location Transfers                -->
    <!-- ========================================================= -->
    <record id="view_location_transfer_tree" model="ir.ui.view">
        <field name="name">stock.location.transfer.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Location Transfers" multi_edit="1" sample="1">
                <field name="name" string="Transfer #" decoration-bf="1"/>
                <field name="scheduled_date" string="Date" widget="date"/>
                <field name="source_analytic_account_id" string="Source Analytic Account" optional="show"/>
                <field name="source_warehouse_id" string="Source Warehouse"/>
                <field name="dest_analytic_account_id" string="Destination Analytic Account" optional="show"/>
                <field name="dest_warehouse_id" string="Destination Warehouse"/>
                <field name="requested_by_id" string="Requested By" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="transfer_state" string="Status" widget="badge"
                       decoration-info="transfer_state == 'draft'"
                       decoration-warning="transfer_state == 'submitted'"
                       decoration-success="transfer_state == 'approved'"
                       decoration-danger="transfer_state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Dedicated Form View for Location Transfers                -->
    <!-- ========================================================= -->
    <record id="view_location_transfer_form" model="ir.ui.view">
        <field name="name">stock.location.transfer.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form string="Location Transfer">
                <header>
                    <button name="action_transfer_submit" type="object" string="Submit" class="btn-primary"
                            invisible="transfer_state != 'draft'"/>
                    <button name="action_transfer_approve" type="object" string="Approve" class="btn-success"
                            invisible="transfer_state != 'submitted'"/>
                    <button name="action_transfer_cancel" type="object" string="Cancel"
                            invisible="transfer_state in ('approved', 'cancel')"/>
                    <field name="transfer_state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1 class="d-flex">
                            <span invisible="name and name != '/'">New Location Transfer</span>
                            <field name="name" readonly="1" invisible="not name or name == '/'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="From (Source)">
                            <field name="source_analytic_account_id" string="Source Analytic Account"
                                   options="{'no_create': True}"
                                   required="1"
                                   readonly="transfer_state != 'draft'"/>
                            <field name="source_warehouse_id" string="Source Warehouse"
                                   domain="[('analytic_account_id', '=', source_analytic_account_id)]"
                                   options="{'no_create': True}"
                                   required="1"
                                   readonly="transfer_state != 'draft'"/>
                            <!-- Technical locations hidden from user view -->
                            <field name="location_id" invisible="1" force_save="1"/>
                            <field name="picking_type_id" invisible="1"/>
                        </group>
                        <group string="To (Destination)">
                            <field name="dest_analytic_account_id" string="Destination Analytic Account"
                                   options="{'no_create': True}"
                                   required="1"
                                   readonly="transfer_state != 'draft'"/>
                            <field name="dest_warehouse_id" string="Destination Warehouse"
                                   domain="[('analytic_account_id', '=', dest_analytic_account_id)]"
                                   options="{'no_create': True}"
                                   required="1"
                                   readonly="transfer_state != 'draft'"/>
                            <!-- Technical locations hidden from user view -->
                            <field name="location_dest_id" invisible="1" force_save="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Details">
                            <field name="requested_by_id" widget="many2one_avatar_user"
                                   readonly="transfer_state == 'approved'"/>
                            <field name="scheduled_date" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products to Transfer" name="products">
                            <field name="move_ids" mode="list"
                                   readonly="transfer_state == 'approved'"
                                   context="{'default_company_id': company_id, 'default_date': scheduled_date, 'default_picking_type_id': picking_type_id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id}">
                                <list editable="bottom" string="Products">
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="state" column_invisible="True"/>
                                    <field name="picking_type_id" column_invisible="True"/>
                                    <field name="location_id" column_invisible="True"/>
                                    <field name="location_dest_id" column_invisible="True"/>
                                    <field name="product_id" required="1" readonly="state != 'draft' and not additional"/>
                                    <field name="description_picking" string="Description" optional="hide"/>
                                    <field name="product_uom_qty" string="Demand Quantity" readonly="parent.transfer_state == 'approved'"/>
                                    <field name="quantity" string="Done Quantity" readonly="parent.transfer_state != 'submitted' and parent.transfer_state != 'approved'"/>
                                    <field name="product_uom" groups="uom.group_uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note" placeholder="Add any special instructions or remarks for this transfer..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Action pointing specifically to our dedicated views       -->
    <!-- ========================================================= -->
    <record id="action_location_transfer_tree" model="ir.actions.act_window">
        <field name="name">Location Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_code', '=', 'internal')]</field>
        <field name="context">{
            'default_is_location_transfer': 1,
            'default_picking_type_code': 'internal',
            'restricted_picking_type_code': 'internal',
            'search_default_internal': 1
        }</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_location_transfer_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_location_transfer_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Location Transfer
            </p>
            <p>
                Move inventory seamlessly between central warehouse, shops, and internal branches.
            </p>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Top Header Navigation Menu Item                           -->
    <!-- ========================================================= -->
    <menuitem id="menu_stock_location_transfers"
              name="Location Transfers"
              parent="stock.menu_stock_root"
              action="action_location_transfer_tree"
              sequence="3"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_ibms_warehouse" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ibms.warehouse</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <!-- Update Statusbar to show Waiting Approval -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,to_approve,sale</attribute>
            </xpath>

            <!-- Hide direct Confirm buttons -->
            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm' and not(@id)]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add Approval buttons in header -->
            <xpath expr="//header" position="inside">
                <button name="action_submit_approval"
                        string="Submit for Approval"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent')"/>
                <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-success"
                        groups="sales_team.group_sale_manager"
                        invisible="state != 'to_approve'"/>
                <button name="action_reject_wizard"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                        groups="sales_team.group_sale_manager"
                        invisible="state != 'to_approve'"/>
            </xpath>

            <!-- Rejection Alert Banner -->
            <xpath expr="//header" position="after">
                <div class="alert alert-danger" role="alert" invisible="not rejection_reason or state not in ('draft', 'sent')">
                    <strong>Order Was Rejected by Management: </strong>
                    <field name="rejection_reason" readonly="1" class="d-inline fw-bold"/>
                </div>
            </xpath>

            <!-- Place Analytic Account (labeled Location) and Warehouse directly after Customer in the main header -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="analytic_account_id" string="Location" options="{'no_create': True}" readonly="state == 'sale'"/>
                <field name="warehouse_id"
                       domain="[('analytic_account_id', '=', analytic_account_id)] if analytic_account_id else []"
                       options="{'no_create': True}"
                       force_save="1"
                       readonly="state == 'sale'"/>
            </xpath>
            <!-- Place Payment Proof and Payment Note right after Payment Terms -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="payment_proof_filename" invisible="1"/>
                <field name="payment_proof" widget="image" filename="payment_proof_filename" options="{'size': [110, 110]}"/>
                <field name="payment_note" placeholder="Txn ID, Bank Ref, Telebirr / CBE confirmation..."/>
            </xpath>
            <!-- Hide the duplicate Warehouse field in the Delivery/Shipping section -->
            <xpath expr="//group[@name='sale_shipping']//field[@name='warehouse_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Approver and Approval Date in Other Info tab -->
            <xpath expr="//group[@name='sales_person']" position="inside">
                <field name="approver_id" readonly="1" invisible="not approver_id"/>
                <field name="approval_date" readonly="1" invisible="not approval_date"/>
            </xpath>
        </field>
    </record>

    <!-- Search View: Add Waiting Approval filter -->
    <record id="view_sales_order_filter_inherit_ibms" model="ir.ui.view">
        <field name="name">sale.order.list.select.inherit.ibms</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter string="Waiting Approval" name="filter_to_approve" domain="[('state', '=', 'to_approve')]"/>
            </xpath>
        </field>
    </record>
</odoo>

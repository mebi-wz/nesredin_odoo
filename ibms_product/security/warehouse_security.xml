<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Record Rule for Transfers / Location Transfers -->
        <record id="rule_stock_picking_warehouse_restriction" model="ir.rule">
            <field name="name">Warehouse User Picking Restriction</field>
            <field name="model_id" search="[('model', '=', 'stock.picking')]" model="ir.model"/>
            <field name="domain_force">
                [
                    '|', '|',
                    ('picking_type_id.warehouse_id', 'in', user.allowed_warehouse_ids.ids if user.allowed_warehouse_ids else user.env['stock.warehouse'].search([]).ids),
                    ('source_warehouse_id', 'in', user.allowed_warehouse_ids.ids if user.allowed_warehouse_ids else user.env['stock.warehouse'].search([]).ids),
                    ('dest_warehouse_id', 'in', user.allowed_warehouse_ids.ids if user.allowed_warehouse_ids else user.env['stock.warehouse'].search([]).ids)
                ]
            </field>
            <field name="groups" eval="[Command.link(ref('stock.group_stock_user'))]"/>
        </record>

        <!-- Record Rule for Stock on Hand (Quants) -->
        <record id="rule_stock_quant_warehouse_restriction" model="ir.rule">
            <field name="name">Warehouse User Stock Quant Restriction</field>
            <field name="model_id" search="[('model', '=', 'stock.quant')]" model="ir.model"/>
            <field name="domain_force">
                [
                    '|',
                    ('location_id.warehouse_id', '=', False),
                    ('location_id.warehouse_id', 'in', user.allowed_warehouse_ids.ids if user.allowed_warehouse_ids else user.env['stock.warehouse'].search([]).ids)
                ]
            </field>
            <field name="groups" eval="[Command.link(ref('stock.group_stock_user'))]"/>
        </record>
    </data>
</odoo>

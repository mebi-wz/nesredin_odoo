<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="category_store_requisition" model="ir.module.category">
            <field name="name">Procurement</field>
            <field name="description">Helps you manage procurement and store requisitions.</field>
            <field name="sequence">10</field>
        </record>

        <!-- Separate Privileges per Group to force checkboxes -->
        <record id="privilege_store_requisition_user" model="res.groups.privilege">
            <field name="name">Store Requisition: Requester</field>
            <field name="category_id" ref="category_store_requisition"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_store_requisition_verifier" model="res.groups.privilege">
            <field name="name">Store Requisition: Verifier</field>
            <field name="category_id" ref="category_store_requisition"/>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_store_requisition_budget_manager" model="res.groups.privilege">
            <field name="name">Store Requisition: Budget Manager</field>
            <field name="category_id" ref="category_store_requisition"/>
            <field name="sequence">30</field>
        </record>

        <record id="privilege_store_requisition_manager" model="res.groups.privilege">
            <field name="name">Store Requisition: Store Manager</field>
            <field name="category_id" ref="category_store_requisition"/>
            <field name="sequence">40</field>
        </record>

        <record id="group_store_requisition_user" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_store_requisition_user"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">1</field>
        </record>

        <record id="group_store_requisition_verifier" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_store_requisition_verifier"/>
            <field name="implied_ids" eval="[(4, ref('group_store_requisition_user'))]"/>
            <field name="sequence">1</field>
        </record>

        <record id="group_store_requisition_budget_manager" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_store_requisition_budget_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_store_requisition_user'))]"/>
            <field name="sequence">1</field>
        </record>

        <record id="group_store_requisition_manager" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_store_requisition_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_store_requisition_user'))]"/>
            <field name="sequence">1</field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_requisition_wizard_form" model="ir.ui.view">
        <field name="name">store.requisition.wizard.form</field>
        <field name="model">store.requisition.wizard</field>
        <field name="arch" type="xml">
            <form string="Partial Stock Detected">
                <field name="requisition_id" invisible="1"/>
                <field name="message" widget="html" nolabel="1" readonly="1"/>
                <group string="Items to Issue">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="requisition_line_id" invisible="1"/>
                            <field name="product_id" force_save="1"/>
                            <field name="qty_requested" string="Requested" force_save="1"/>
                            <field name="qty_remaining" string="Remaining" force_save="1"/>
                            <field name="qty_on_hand" string="On Hand" force_save="1"/>
                            <field name="issued_qty" string="Qty to Issue" class="oe_highlight"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_create_siv_only" 
                            string="Create SIV Only" 
                            type="object" 
                            class="btn-primary"/>
                    <button name="action_cancel" 
                            string="Cancel" 
                            type="object" 
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

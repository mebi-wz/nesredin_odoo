<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View (Stock / Inventory Tab) -->
    <record id="view_product_template_form_amc" model="ir.ui.view">
        <field name="name">product.template.form.amc</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Monthly Consumption &amp; Stock Analysis" name="stock_consumption_analysis">
                    <label for="avg_monthly_consumption"/>
                    <div class="o_row">
                        <field name="avg_monthly_consumption"/>
                        <span> Units / Month</span>
                        <button name="action_compute_amc" type="object" string="Compute AMC" class="btn btn-secondary btn-sm ms-2" icon="fa-refresh" title="Compute based on past 12 months consumption"/>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Product Product (Variant) Search View - Power Many2one "Search More..." -->
    <record id="product_search_form_view_inherit_procurement" model="ir.ui.view">
        <field name="name">product.product.search.inherit.procurement</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="replace">
                <field name="name" string="Product" filter_domain="['|', '|', '|', '|', ('default_code', 'ilike', self), ('part_number', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self), ('categ_id', 'ilike', self)]"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="default_code" string="Product Code" filter_domain="[('default_code', 'ilike', self)]"/>
                <field name="part_number" string="Part Number" filter_domain="[('part_number', 'ilike', self)]"/>
                <field name="categ_id" string="Category" filter_domain="[('categ_id', 'child_of', self)]"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Search View -->
    <record id="view_product_template_search_amc" model="ir.ui.view">
        <field name="name">product.template.search.amc</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="replace">
                <field name="name" string="Product" filter_domain="['|', '|', '|', '|', ('default_code', 'ilike', self), ('part_number', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self), ('categ_id', 'ilike', self)]"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="default_code" string="Product Code" filter_domain="[('default_code', 'ilike', self)]"/>
                <field name="part_number" string="Part Number" filter_domain="[('part_number', 'ilike', self)]"/>
                <field name="avg_monthly_consumption"/>
            </xpath>
            <xpath expr="//filter[@name='filter_to_purchase']" position="after">
                <filter string="Has Monthly Consumption" name="has_consumption" domain="[('avg_monthly_consumption', '>', 0)]"/>
            </xpath>
        </field>
    </record>

    <!-- Product Product (Variant) Tree View - Display columns in Search More... popup -->
    <record id="product_product_tree_view_inherit_procurement" model="ir.ui.view">
        <field name="name">product.product.list.inherit.procurement</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="before">
                <field name="image_1920" string="Image" widget="image" options="{'zoom': true, 'preview_image': 'image_128', 'size': [40, 40]}" width="45" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Product Code</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="part_number" string="Part Number" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- Product Template List / Tree View -->
    <record id="view_product_template_tree_amc" model="ir.ui.view">
        <field name="name">product.template.list.amc</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="before">
                <field name="image_1920" string="Image" widget="image" options="{'zoom': true, 'preview_image': 'image_128', 'size': [40, 40]}" width="45" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Product Code</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="part_number" string="Part Number" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="avg_monthly_consumption" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>


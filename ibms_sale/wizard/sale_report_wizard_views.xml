<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_report_wizard_form" model="ir.ui.view">
        <field name="name">sale.report.wizard.form</field>
        <field name="model">sale.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Reports">
                <sheet>
                    <div class="oe_title">
                        <h2>Sales Reports &amp; Analysis</h2>
                        <p class="text-muted">Generate Daily, Customer, or Product sales reports with full part number cross-referencing and images.</p>
                    </div>
                    <group>
                        <group string="Report Configuration">
                            <field name="report_type" widget="radio"/>
                            <field name="order_state" widget="radio"/>
                        </group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Filters (Optional)" name="filters">
                            <group>
                                <field name="partner_ids" widget="many2many_tags" placeholder="All Customers (or select specific ones)..."/>
                                <field name="product_ids" widget="many2many_tags" placeholder="All Products (or select specific ones)..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_view_on_screen" string="View on Screen" type="object" class="btn-primary" icon="fa-desktop"/>
                    <button name="action_print_pdf" string="Print PDF Report" type="object" class="btn-success" icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_report_wizard" model="ir.actions.act_window">
        <field name="name">Sales Reports (Daily / Customer / Product)</field>
        <field name="res_model">sale.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

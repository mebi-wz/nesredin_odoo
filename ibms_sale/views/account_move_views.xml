<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ibms_sale_payment" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ibms.sale.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="payment_proof_filename" invisible="1"/>
                <field name="payment_proof" widget="image" filename="payment_proof_filename" options="{'size': [110, 110]}"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
                <field name="payment_note" placeholder="Txn ID, Bank Ref, Telebirr / CBE confirmation..."
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
        </field>
    </record>
</odoo>

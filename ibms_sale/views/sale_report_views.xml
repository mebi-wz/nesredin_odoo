<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sales Analysis List View: Add Image and Part Number -->
    <record id="sale_report_view_tree_inherit_ibms" model="ir.ui.view">
        <field name="name">sale.report.view.list.inherit.ibms</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.sale_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="image_1920"
                       string="Image"
                       widget="image"
                       options="{'zoom': true, 'preview_image': 'image_128', 'size': [40, 40]}"
                       width="45"
                       optional="show"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="part_number" string="Part Number" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Sales Analysis Search View: Add Part Number search and grouping -->
    <record id="view_order_product_search_inherit_ibms" model="ir.ui.view">
        <field name="name">sale.report.search.inherit.ibms</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="part_number" string="Part Number"/>
            </xpath>
            <xpath expr="//filter[@name='product_tmpl_id']" position="after">
                <filter string="Part Number" name="group_by_part_number" context="{'group_by':'part_number'}"/>
            </xpath>
        </field>
    </record>
</odoo>
